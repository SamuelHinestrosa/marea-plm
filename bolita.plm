// Marea: la bolita, escrita con pleamar.
//
// Las medidas salen de la lámina de tamaño real (`design/concepts/
// 2026-09-12-reposo-vivo/referencia-real-limpia.png`): cuerpo de 46 px, ojos de
// 5 × 13 con las puntas redondas, separados 13 entre centros y 2,5 px por debajo
// del centro del cuerpo.
//
// Los tiempos salen del contrato (`docs/ANIMACIONES.md`), y no se negocian:
// parpadeo breve cada 5,2 s, mirada cada 11 s, y cada 12–24 s la «respiración
// de Marea» de 1,3 s —los ojos miran primero, el cuerpo sube 2 px, parpadea del
// todo, se asienta y vuelve exacto a neutral—.
//
// Todo lo de este fichero lo ejecuta el render. Aquí no hay lógica ninguna.

import "comun/paleta.plm"

scene Marea {
    surface {
        size: 160, 120
        anchor: top
        margin: 24
        screens: "HDMI-A-1"
    }

    // ── dónde vive ───────────────────────────────────────────────
    let cx = 80
    let cy = 46
    let r = 23                        // la mitad de los 46 px de la lámina

    // ── lo que la mueve ──────────────────────────────────────────
    //  `pose` es lo que un gesto lleva de la mano: al acabar vuelve sola a su
    //  base, y eso es lo que hace que la respiración «regrese exacto a neutral».
    pose body.y = 0                   // cuánto sube el cuerpo
    pose lid = 1                      // los párpados: 1 abiertos, 0 cerrados
    pose eyes = 13                    // lo altos que son los ojos
    pose look.y = 0                   // la mirada dentro de la cara
    pose tilt = 0                     // la inclinación del cuerpo

    prop gaze.x = 0 ~gentle           // hacia dónde miran, siguiendo al ratón
    prop gaze.y = 0 ~gentle
    prop press = 0 ~quick             // la compresión bajo el clic

    // ── reposo vivo ──────────────────────────────────────────────
    //  Parpadeo breve, cada 5,2 s. Y la mirada, que sigue al ratón de cerca.
    blink lid every 5.2s for 120ms
    look gaze.x, gaze.y at cx, cy reach 6, 3.5 within 260

    //  La respiración de Marea. Ambiental: cualquier otro gesto la corta.
    gesture breathe ambient {
        //  Primero miran los ojos: es lo que la hace parecer suya y no un tic.
        220ms in_out_sine        { look.y: -1.2 }
        //  El cuerpo sube dos píxeles, ni uno más.
        320ms out_quad           { body.y: -2; look.y: -0.6 }
        //  Y parpadea del todo mientras está arriba.
        180ms in_out_sine        { lid: 0; body.y: -2 }
        200ms in_out_sine        { lid: 1; body.y: -1.4 }
        //  Se asienta con una asimetría mínima, y vuelve a neutral.
        380ms out_back           { tilt: 0.012 }
    }
    every 12s..24s { play breathe }

    // ── el cuerpo ────────────────────────────────────────────────
    //  La sombra es una copia de ella misma, no una elipse plana debajo.
    body {
        color: coal
        rim: 6%
        shadow: 0, 7, 16, 34%
        ellipse cuerpo {
            at: cx, cy + body.y
            radius: r
            rotate: tilt
            scale: 1 + press * 0.04, 1 - press * 0.05
        }
    }

    // ── la cara ──────────────────────────────────────────────────
    //  Recortada al cuerpo: lo que se salga de la bolita no existe. Es lo que
    //  dejará que los ojos se conviertan en otra cosa sin salirse de ella.
    group {
        clip inset 1 ellipse { at: cx, cy + body.y; radius: r }
        move: gaze.x, gaze.y + look.y
        box {
            at: cx - 6.5, cy + body.y + 2.5
            size: 5, eyes * lid
            corner: 2.5
            color: ink
        }
        box {
            at: cx + 6.5, cy + body.y + 2.5
            size: 5, eyes * lid
            corner: 2.5
            color: ink
        }
    }

    // ── lo que responde al ratón ─────────────────────────────────
    zone box cuerpo_zona { at: cx, cy + body.y; size: 2 * r, 2 * r; corner: r; cursor: pointer }
    on press cuerpo_zona { press: 1 }
    on release cuerpo_zona { press: 0 }
}
