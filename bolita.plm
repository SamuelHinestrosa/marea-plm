// Marea: la bolita, escrita con pleamar.
//
// Las medidas salen de la lámina de tamaño real (`design/concepts/
// 2026-09-12-reposo-vivo/referencia-real-limpia.png`): cuerpo de 46 px, ojos de
// 5 × 13 con las puntas redondas, separados 13 entre centros y 2,5 px por debajo
// del centro del cuerpo.
//
// Los tiempos salen del contrato (`docs/ANIMACIONES.md`), y no se negocian:
// parpadeo breve cada 5,2 s, mirada cada 11 s, y cada 12–24 s la «respiración
// de Marea» de 1,3 s —los ojos miran primero, el cuerpo sube 2 px, parpadea del
// todo, se asienta y vuelve exacto a neutral—.
//
// Todo lo de este fichero lo ejecuta el render. Aquí no hay lógica ninguna.

import "comun/paleta.plm"

scene Marea {
    permissions { services: "audio", "clock" }
    service clock as ahora { time: text = "--:--"; date: text }
    service audio as sonido { volume: number; muted: bool }

    surface {
        //  La superficie tiene que dar de sí para la tarjeta **y su sombra**: 18 px
        //  de desplazamiento más 44 de difusión, por abajo y por los lados. Si no,
        //  la sombra se corta en seco contra el borde y se ve el recorte.
        size: 820, 580
        anchor: top
        margin: 0
        screens: "HDMI-A-1"
    }

    // ── dónde vive ───────────────────────────────────────────────
    //  En reposo vive arriba y centrada; al abrirse se aparta a la izquierda para
    //  presentar la tarjeta, que es como está en la lámina del centro de control.
    let cx = 120 + (1 - card) * 240
    //  Abierta, baja a la altura de la cabecera de la tarjeta, como en la lámina.
    let cy = 46 + card * 46
    let r = 23                        // la mitad de los 46 px de la lámina

    // ── lo que la mueve ──────────────────────────────────────────
    //  `pose` es lo que un gesto lleva de la mano: al acabar vuelve sola a su
    //  base, y eso es lo que hace que la respiración «regrese exacto a neutral».
    pose body.y = 0                   // cuánto sube el cuerpo
    pose lid = 1                      // los párpados: 1 abiertos, 0 cerrados
    pose eyes = 13                    // lo altos que son los ojos
    pose look.y = 0                   // la mirada dentro de la cara
    pose tilt = 0                     // la inclinación del cuerpo
    pose sx = 1                       // lo que se estira: a lo ancho
    pose sy = 1                       // y a lo alto
    pose shut = 0                     // el obturador: 1 cerrado

    prop gaze.x = 0 ~gentle           // hacia dónde miran, siguiendo al ratón
    prop gaze.y = 0 ~gentle
    prop press = 0 ~quick             // la compresión bajo el clic

    //  El viaje de salir del borde y volver: 620 ms, que es lo que dice el
    //  contrato. Una gota que se va en 200 ms es una gota que nadie vio irse.
    fact hidden = true                // «meterse en el borde», encendido
    fact needed = false               // algo la reclama: un aviso, el puntero…
    prop out = 0 ~620ms               // 0 hundida, 1 separada del todo

    //  La tarjeta. Dos cosas que viajan por separado, y ahí está el truco: al
    //  abrir manda la geometría y el contenido la sigue; al cerrar se funde
    //  primero el contenido y **luego** se recoge la geometría.
    fact open = false
    // ── los avisos ───────────────────────────────────────────────
    //  «Todo llega, tú decides»: llegar no abre nada. Entra una tarjeta pequeña
    //  a su lado, ella se sobresalta y la mira, se queda lo que hace falta para
    //  leerla y luego se estrecha hasta ser una gota del color de su categoría,
    //  que vuela por una curva a su hombro. Al llegar, un trago.
    event notice                       // llega uno: antes se dicen `cat`, `who` y `line`
    event landed
    event tray ->                      // pulsar la tarjeta: la lógica abre la bandeja
    fact cat = 1                       // 1 mensajes · 2 trabajo · 3 calendario · 4 sistema
    fact cual = 1                      // la del que se está leyendo: `cat` puede cambiar mientras
    fact miseq = 0                     // y su turno de llegada: aterriza tarde, pero llegó antes
    event direct                       // uno que llega con otro en pantalla
    text who = ""
    text line = ""
    fact fase = 0                      // 0 nada · 1 leyéndose · 2 volando
    fact sobre = false                 // el puntero encima: detiene la lectura
    fact marca = 0                     // cada vez que la lectura vuelve a empezar
    fact seq = 0                       // para saber cuál es el más reciente
    prop entra = 0 ~220ms              // la tarjeta, entrando
    prop mine = 0 ~220ms               // 0 tarjeta, 1 gota en su sitio
    prop atenta = 0 ~gentle            // mirando la tarjeta
    follow atenta = if(fase == 1, 1, 0)

    let azul = #6fb1e6
    let lila = #a68be4
    let verde = #8fd1ae
    let ambar = #e3a35c
    //  Cuántos hay de cada una, y cuándo llegó el último: se declaran antes
    //  que las gotas porque cada gota mira a las otras tres.
    repeat k in 1..5 {
        fact n.$k = 0
        fact last.$k = 0
    }

    //  La nota de la hora.
    fact note = false
    event calendar ->                  // un clic en ella: la lógica abre el calendario
    prop nota = 0 ~190ms
    follow nota = if(note and not open and face == eye and out > 0.9 and fase == 0, 1, 0)
    let nota.x = cx + (23 + 14 + 52) * nota

    prop card = 0 ~290ms
    prop content = 0 ~200ms

    //  El nivel en la cara. El volumen lo trae el sistema: ni una línea de
    //  lógica, y por eso el deslizador del panel y la tecla del teclado se ven
    //  exactamente igual desde aquí —que es justo lo que pide el contrato—.
    prop meter = 0 ~180ms             // 0 cara, 1 barra
    prop nivel = 0 ~quick             // lo que marca la barra

    //  ── lo que la cara puede ser ────────────────────────────────
    //  Un hecho con tipo: el compilador comprueba contra qué se compara, así
    //  que `face == lupa` no pasa de la primera lectura.
    fact face: eye | count | camera | rec = eye
    fact left = 0                     // lo que queda de la cuenta
    fact taping = false               // el grabador corriendo DE VERDAD

    prop num = 0 ~260ms               // 0 cara, 1 número
    prop cam = 0 ~220ms               // 0 cara, 1 cámara
    prop dot = 0 ~260ms               // 0 cara, 1 disco
    prop red = 0 ~200ms               // el rojo, que es otra cosa que el disco
    prop pop = 0 ~lively              // el rebote de la cuenta

    //  Cada estado es un muelle que sigue a su hecho. Por eso uno puede
    //  interrumpir a otro a mitad de camino y lo único que pasa es que la
    //  forma se dobla: no hay dos animaciones peleándose por los mismos ojos.
    follow num = if(face == count, 1, 0)
    follow cam = if(face == camera, 1, 0)
    follow dot = if(face == rec, 1, 0)
    follow red = if(taping, 1, 0)

    // ── reposo vivo ──────────────────────────────────────────────
    //  Parpadeo breve, cada 5,2 s. Y la mirada, que sigue al ratón de cerca.
    blink lid every 5.2s for 120ms
    look gaze.x, gaze.y at cx, cy reach 6, 3.5 within 260

    //  La respiración de Marea. Ambiental: cualquier otro gesto la corta.
    gesture breathe ambient {
        //  Primero miran los ojos: es lo que la hace parecer suya y no un tic.
        220ms in_out_sine        { look.y: -1.2 }
        //  El cuerpo sube dos píxeles, ni uno más.
        320ms out_quad           { body.y: -2; look.y: -0.6 }
        //  Y parpadea del todo mientras está arriba.
        180ms in_out_sine        { lid: 0; body.y: -2 }
        200ms in_out_sine        { lid: 1; body.y: -1.4 }
        //  Se asienta con una asimetría mínima, y vuelve a neutral.
        380ms out_back           { tilt: 0.012 }
    }
    every 12s..24s { play breathe }

    //  El respingo: salta 8 px sin anticipar, con los ojos muy abiertos,
    //  aterriza elástico y rebota corto. Los números de Marea, por 46/56.
    gesture startle reflex {
        75ms out_cubic            { eyes: 16.4; sx: 0.90; sy: 1.13; body.y: -2.5 }
        105ms out_quad hold 90ms  { eyes: 16.4; sx: 0.98; sy: 1.04; body.y: -6.6 }
        145ms in_quad             { eyes: 14.8; sx: 0.96; sy: 1.06 }
        100ms out_quad            { eyes: 14.8; sx: 1.10; sy: 0.82; body.y: 3.3 }
        130ms out_quad            { eyes: 14; sx: 0.98; sy: 1.04; body.y: -2.5; tilt: 0.07 }
        120ms                     { eyes: 14; sx: 1.02; sy: 0.96; body.y: 0.8; tilt: 0.05 }
        160ms hold 100ms          { eyes: 14; tilt: 0.05 }
        200ms
    }
    //  El trago, cuando la gota llega a su hombro.
    gesture gulp reflex {
        90ms out_quad   { sx: 1.06; sy: 0.94; body.y: 1 }
        180ms out_back
    }

    follow out = if(hidden and not needed, 0, 1)

    // ── la fotografía ────────────────────────────────────────────
    //  No se apaga de golpe antes de que se congele la pantalla: anticipa 70 ms,
    //  se estira y SALE por el borde de arriba en 150. Los números son los de
    //  Marea, por 46/56; el último sube más que allí porque esta superficie no
    //  se esconde: aquí es ella la que tiene que quedar fuera del todo.
    event snap                         // alguien pide una foto
    event gone                         // ya no está en el encuadre
    prop away = 0 ~quick               // 1 mientras espera arriba, fuera de la vista

    gesture retire state {
        70ms out_quad           { eyes: 14.8; sx: 0.94; sy: 1.12; body.y: -3.3 }
        150ms in_cubic          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
        //  `emit` suena al EMPEZAR su fotograma, así que va en uno propio: el
        //  aviso de «ya no estoy» tiene que llegar cuando ya no está.
        30ms emit gone          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
    }
    //  Sale igual para dos cosas, y al llegar arriba hace una u otra.
    fact para: foto | rincon = foto
    on snap { para = foto; play retire }

    //  El disparo. El obturador es una pose y el clic un gesto: cierra en 80,
    //  aguanta, abre en 170 —los tiempos de Marea— y devuelve la cara. Y un
    //  culatazo mínimo del cuerpo al cerrar, que allí no está: una cámara que
    //  dispara sin moverse es un icono, no una cámara.
    event shoot
    event taken
    gesture click state {
        80ms out_quad hold 10ms  { shut: 1; sx: 1.05; sy: 0.95 }
        170ms out_back           { shut: 0 }
        120ms
        10ms emit taken
    }
    on shoot while face == camera { play click }
    on taken { face = eye }
    //  Fuera ya, se queda fuera —el gesto devuelve la pose a su base, y sin
    //  esto volvería a caer en el mismo frame— y cambia de cara donde nadie la
    //  ve. 200 ms de margen, que es lo que el compositor tarda en retirar la
    //  capa: están medidos en Marea, con 90 salía un fantasma suyo en la foto.
    //  Y vuelve cayendo con un muelle vivo, que rebota un pelo al aterrizar:
    //  no «aparece» con la cámara puesta, regresa.
    on gone while para == foto {
        away: 1 ~16ms
        face = camera
        away: 0 ~lively after 220ms
    }

    //  Hundida asoma algo menos de la mitad; separada cuelga a su propia altura.
    let sube = if(hidden, (1 - out) * 49, 0)
    let cy_real = cy + body.y - sube - away * 84

    //  El cuello: mínimo en reposo y máximo a mitad de la separación, que es una
    //  campana. Al final no queda nada y el hilo se rompe solo.
    let cuello = 30 * 4 * out * (1 - out) * if(hidden, 1, 0)

    // ── el cuerpo ────────────────────────────────────────────────
    //  El agua del borde y la bolita son una sola silueta: el cuello no se
    //  dibuja, sale de fundirlas. Por eso se afina y rompe sin que nadie lo
    //  calcule, y por eso es cóncavo.
    body {
        color: coal
        rim: 6%
        shadow: 0, 7, 16, 34%
        box agua { from: cx - 70, -70; size: 140, 70 * if(hidden, 1, 0) }
        ellipse cuerpo {
            at: cx, cy_real
            radius: r
            rotate: tilt
            scale: sx + press * 0.04, sy - press * 0.05
            blend: cuello
        }
        //  La nota de la hora, que sale de DETRÁS de ella: nace en su centro con
        //  ancho cero y se desliza a la derecha hasta quedar a 14 px, con su
        //  cuello a mitad de camino. Es parte del mismo cuerpo, así que la
        //  sombra es una sola y el borde también.
        box nota_caja {
            at: nota.x, cy_real
            size: 104 * clamp(nota * 1.6, 0, 1), 56 * clamp(nota * 2.4, 0, 1)
            corner: 13
            blend: 18 * 4 * nota * (1 - nota)
        }
    }

    //  Lo que lleva escrito. La hora la trae el sistema; aquí no hay lógica.
    group {
        opacity: clamp(nota * 4 - 3, 0, 1)
        move: (1 - nota) * -12, 0
        text ahora.time { at: nota.x - 39, cy_real - 9; anchor: left center; size: 21; weight: 600; color: #f6f6f5 }
        text "{upper(ahora.date)}" { at: nota.x - 39, cy_real + 13; anchor: left center; size: 10; color: #8b8f95 }
    }

    // ── la cara ──────────────────────────────────────────────────
    //  Recortada al cuerpo: lo que se salga de la bolita no existe. Es lo que
    //  deja que los ojos se conviertan en otra cosa sin salirse de ella.
    //
    //  Todo lo que sigue es UNA cadena: el ojo de siempre, y cada estado
    //  tirando de él. Se escribe así y no con pesos sueltos porque cada línea
    //  dice qué hace ese estado, y porque dos muelles a mitad de camino nunca
    //  suman uno. La cara no se cambia por otra: se dobla hasta ser otra cosa.
    //
    //  Las medidas salen de la lámina de Marea, que dibuja la cara en un
    //  espacio de 56; aquí la bolita mide 46, así que todo va por 46/56.

    //  Es un componente porque ella puede estar en dos sitios: arriba, y metida
    //  en la esquina mientras graba. La misma cara, los mismos muelles; lo único
    //  que cambia es dónde está y hacia dónde puede mirar.
    component Cara(x: number, y: number, gx: number, gy: number) {
        //  Cuando manda otra cosa, el párpado deja de contar: una cámara no
        //  parpadea y un número tampoco.
        let manda = clamp(meter + num + cam + dot, 0, 1)
        let parpado = lid + (1 - lid) * manda

        //  1. El ojo, y el nivel tumbándolo. (Medido en «El nivel en la cara».)
        let o.w = 5 + 8 * meter
        let o.h = eyes * parpado * (1 - meter) + 5 * meter
        let o.sep = 6.5 - 4 * meter

        //  2. La cuenta atrás. Los dos ojos se van al centro y se redondean hasta
        //  ser UNA gota —se funden de verdad, que para eso son un cuerpo—, y
        //  entonces la gota **se abre como un diafragma**: crece mientras se le
        //  come el centro, se queda en un anillo, y dentro estaba el número. No es
        //  que los ojos se escondan y aparezca un número encima; es que el número
        //  estaba detrás de ellos y los ojos se abren para enseñarlo.
        let junta = clamp(num * 2, 0, 1)
        let abre = clamp(num * 2 - 1, 0, 1)
        let c.w = o.w + (9 - o.w) * junta
        let c.h = o.h + (9 - o.h) * junta
        let c.sep = o.sep * (1 - junta)
        //  18 y no 30: el anillo se queda en algo más de media bolita. Con 30 casi
        //  la llenaba, y en 260 ms eso no es un diafragma, es un fogonazo.
        let g.w = c.w + 18 * abre
        let g.h = c.h + 18 * abre

        //  3. La cámara. El izquierdo se abre en el objetivo y el derecho se
        //  estira alrededor hasta ser el cuerpo; los dos al centro de la cara.
        //  El objetivo mide 13 de la lámina, y 5 con el obturador cerrado.
        let ojo.l = 10.7 - 5.4 * shut
        let l.w = g.w + (ojo.l - g.w) * cam
        let l.h = g.h + (ojo.l - g.h) * cam
        let r.w = g.w + (24.6 - g.w) * cam
        let r.h = g.h + (17.3 - g.h) * cam
        let sep = c.sep * (1 - cam)

        //  4. El disco de grabar: el ojo izquierdo, y solo él. El derecho sigue
        //  siendo un ojo y sigue al puntero, que es lo que la mantiene viva
        //  mientras dura. El disco se queda donde estaba el ojo, no se centra.
        let d.w = l.w + (9 - l.w) * dot
        let d.h = l.h + (9 - l.h) * dot

        let ojo.y = y + 2.5
        let l.x = x - sep
        let r.x = x + sep
        //  Redondo cuando es redondo: la mitad del lado corto sale pill de pie,
        //  pill tumbado, gota, objetivo y disco sin decirlo cinco veces. El cuerpo
        //  de la cámara es el único que se aparta, porque tiene esquina propia.
        let l.corner = min(d.w, d.h) / 2
        let r.corner = min(r.w, r.h) / 2 + (4.9 - min(r.w, r.h) / 2) * cam
        //  Y el puente entre los dos: campana, como la del menisco. Máximo justo
        //  cuando se tocan —a mitad del viaje del nivel, y al juntarse en la gota—
        //  y nada en los extremos.
        let ojo.fusion = 6 * 4 * meter * (1 - meter) + 7 * junta * (1 - cam)

        group {
            clip inset 1 ellipse { at: x, y; radius: 23 }
            move: gx, gy + look.y

            //  Los ojos, que aquí son todo: pista del nivel, gota de la cuenta,
            //  objetivo y cuerpo de la cámara, y sitio del disco rojo. Se
            //  oscurecen tumbados porque una pista blanca con menta encima no se
            //  lee como un nivel; y se van cuando la gota se abre.
            body {
                color: mix(ink, #34373a, meter)
                box { at: l.x, ojo.y; size: d.w, d.h; corner: l.corner; blend: ojo.fusion }
                box { at: r.x, ojo.y; size: r.w, r.h; corner: r.corner; blend: ojo.fusion }
            }

            //  Lo lleno del nivel es **la misma pista**, pintada otra vez y
            //  recortada por la izquierda. Así la menta tiene la forma exacta de la
            //  barra —con sus puntas— sin dibujar ni una geometría más. En su
            //  propio grupo: un recorte llega hasta el final del grupo donde vive.
            group {
                clip inset 0 box { from: x - 9, ojo.y - 4; size: 18 * nivel, 8 }
                body {
                    color: mix(mint, #6b7280, sonido.muted)
                    opacity: meter
                    box { at: l.x, ojo.y; size: d.w, d.h; corner: l.corner; blend: ojo.fusion }
                    box { at: r.x, ojo.y; size: r.w, r.h; corner: r.corner; blend: ojo.fusion }
                }
            }

            //  El diafragma. La gota no se desvanece: se le come el centro con una
            //  forma del color de la bolita, así que queda un anillo que crece hasta
            //  que ya no hay anillo. Un número blanco sobre una gota blanca que se
            //  funde sale gris y turbio; esto sale limpio, y además es la misma
            //  cuenta de siempre: aquí todo son distancias, y un agujero es una
            //  forma más.
            body {
                color: coal
                ellipse { at: x, ojo.y; radius: g.w / 2 * abre * 1.25 }
            }

            //  El hueco de la cámara. El cuerpo no se dibuja con un borde: se le
            //  come el centro con una forma del color de la bolita, que es como se
            //  hace un agujero cuando todo son distancias. Crece desde nada, así
            //  que el ojo se vacía en vez de cambiarse por un marco.
            body {
                color: coal
                box { at: x, ojo.y; size: 21.3 * cam, 14 * cam; corner: 3.3 }
            }

            //  Y el objetivo encima del hueco, que es lo único que el hueco se
            //  llevó por delante. Misma forma y mismo sitio que el ojo de debajo,
            //  así que no se ve ningún cruce: se ve un ojo que se vacía alrededor.
            body {
                color: ink
                opacity: cam
                ellipse { at: x, ojo.y; radius: ojo.l / 2 }
            }

            //  El visor. Este no puede ser un ojo —ya se usaron los dos— así que es
            //  una marca aparte, despegada del contorno para que no se junten en
            //  una costura, y entra y sale con el resto.
            box {
                at: x - 6.2, ojo.y - 11.6
                size: 5.7 * cam, 2.9 * cam
                corner: 1.2
                color: ink
            }

            //  El disco de grabar, justo encima del ojo izquierdo y de su tamaño:
            //  no es una forma que llega, es el ojo que se pone rojo. Y el rojo se
            //  enciende con `taping`, no con la pulsación: el disco dice que el
            //  grabador ESTÁ corriendo, no que se lo ha pedido.
            body {
                color: mix(#34373a, #fc6753, red)
                opacity: dot
                ellipse { at: l.x, ojo.y; radius: d.w / 2 }
            }

            //  El porcentaje del nivel, en la frente. Sube los tres últimos píxeles
            //  mientras aparece: entra con la barra en vez de encenderse encima.
            text number(sonido.volume * 100, 0, " %") {
                at: x, y - 9 + (1 - meter) * 3
                anchor: center
                size: 9
                weight: 600
                color: ink
                opacity: meter
            }

            //  El número de la cuenta, donde estaban sus ojos. Grande para leerse
            //  desde el otro lado de la mesa, que es toda la razón de que esté aquí
            //  y no en una etiqueta aparte: lo que va a empezar lo hace ella.
            group {
                pivot: x, ojo.y
                scale: 1 + pop, 1 + pop
                text number(max(left, 1), 0) {
                    at: x, ojo.y
                    anchor: center
                    size: 24.6
                    weight: 300
                    color: ink
                    //  Entra antes que el anillo se vaya del todo: para cuando el
                    //  agujero lo enseña, ya está ahí. Si entrara después, el
                    //  diafragma se abriría sobre nada.
                    opacity: clamp(abre * 1.7, 0, 1)
                }
            }
        }
    }

    Cara(cx, cy_real, gaze.x * (1 - atenta) + 4 * atenta, gaze.y * (1 - atenta))

    // ── las gotas ────────────────────────────────────────────────
    //  Hasta cuatro, una por categoría y **la más reciente primero**, bajando
    //  por su lado derecho desde el hombro. Nada sobresale por encima de su
    //  cabeza: ahí arriba está el borde de la pantalla. El sitio de cada una
    //  es cuántas hay más recientes que ella, y viaja a él con un muelle POR
    //  EL ARCO —el ángulo es lo que se anima, no la x y la y—, así que cuando
    //  llega una nueva las demás se corren hombro abajo sin atajar por dentro
    //  de ella.
    repeat k in 1..5 {
        prop sitio.$k = 0 ~calm
        prop hay.$k = 0 ~240ms
        prop late.$k = 0 ~lively
        follow sitio.$k = if(n.1 > 0 and last.1 > last.$k, 1, 0) + if(n.2 > 0 and last.2 > last.$k, 1, 0) + if(n.3 > 0 and last.3 > last.$k, 1, 0) + if(n.4 > 0 and last.4 > last.$k, 1, 0)
        follow hay.$k = if(n.$k > 0 and not open, 1, 0)
        let ang.$k = -24 + 26 * sitio.$k
        let gx.$k = cx + 31.7 * cos(ang.$k)
        let gy.$k = cy_real + 31.7 * sin(ang.$k)
        group {
            pivot: gx.$k, gy.$k
            scale: hay.$k * (1 + late.$k), hay.$k * (1 + late.$k)
            opacity: hay.$k
            ellipse { at: gx.$k, gy.$k; radius: 7; color: mix(mix(mix(azul, lila, k > 1.5), verde, k > 2.5), ambar, k > 3.5) }
            text number(n.$k, 0) { at: gx.$k, gy.$k + 0.5; anchor: center; size: 8.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 1, 0) }
            text "9+" { at: gx.$k, gy.$k + 0.5; anchor: center; size: 7.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 0, 1) }
        }
        //  La gota donde cae algo late una vez, y su número con ella. Nada en bucle.
        on landed while cual == k { n.$k = n.$k + 1; last.$k = max(last.$k, miseq); impulse late.$k 5 }
        on direct while cat == k { n.$k = n.$k + 1; last.$k = seq; impulse late.$k 5 }
    }

    // ── el aviso que llega ───────────────────────────────────────
    //  Del centro de la tarjeta al hombro por dos curvas distintas: de lado a
    //  ritmo constante, y hacia arriba deprisa. El camino se dobla.
    let av.w = 250 + (8.3 - 250) * mine
    let av.h = 44 + (8.3 - 44) * mine
    let av.x0 = cx + 23 + 14 + 125
    let av.x = av.x0 + (cx + 31.7 * cos(-24) - av.x0) * mine + (1 - entra) * 30
    let av.y = cy_real + (31.7 * sin(-24)) * (1 - (1 - mine) * (1 - mine))
    body {
        color: mix(#0c0f12, mix(mix(mix(azul, lila, cual > 1.5), verde, cual > 2.5), ambar, cual > 3.5), mine)
        opacity: entra
        shadow: 0, 6, 14, 30%
        box { at: av.x, av.y; size: av.w, av.h; corner: min(av.h / 2, 14 + (av.h / 2 - 14) * mine) }
    }
    group {
        opacity: entra * (1 - clamp(mine * 5, 0, 1))
        box { at: av.x - 125 + 5, av.y; size: 3, 28; corner: 1.5; color: mix(mix(mix(azul, lila, cual > 1.5), verde, cual > 2.5), ambar, cual > 3.5) }
        text who { at: av.x - 110, av.y - 8; anchor: left center; size: 11.5; weight: 600; color: #f6f6f5 }
        text line { at: av.x - 110, av.y + 8; anchor: left center; size: 10.5; width: 190; lines: 1; color: #a9adb3 }
        text "ahora" { at: av.x + 113, av.y - 8; anchor: right center; size: 9.5; color: #8b8f95 }
    }

    // ── la tarjeta ───────────────────────────────────────────────
    //  Crece desde la bolita: nace en su sitio y se estira hasta su tamaño.
    let card.w = 560 * card
    let card.h = 404 * card
    let card.x = cx + 40 + card.w / 2
    let card.y = cy_real + card.h / 2 - 8

    body {
        color: #16181a
        rim: 5%
        shadow: 0, 18, 44, 46%
        box tarjeta { at: card.x, card.y; size: card.w, card.h; corner: 22 * card }
    }

    //  Lo de dentro, recortado a la tarjeta mientras se abre.
    clip inset 2 box { at: card.x, card.y; size: card.w, card.h; corner: 22 * card }
    group {
        opacity: content
        move: 0, (1 - content) * 10

        let x0 = card.x - 248
        let y0 = card.y - 172
        text "MAREA" { at: x0, y0; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 35% }
        text "Centro de control" { at: x0, y0 + 24; anchor: left center; size: 19; weight: 500; color: ink }

        //  Los dos deslizadores de la lámina: brillo y volumen.
        box { at: card.x - 176, card.y - 6; size: 192, 200; corner: 16; color: #1d2022 }
        repeat k in 0..2 {
            let sx = card.x - 224 + k * 96
            box { at: sx, card.y - 26; size: 26, 140; corner: 13; color: #2a2e30 }
            box { from: sx - 13, card.y - 6 - k * 24; size: 26, 50 + k * 24; corner: 13; color: mint }
            ellipse { at: sx, card.y - 8 - k * 24; radius: 11; color: #eef3f0 }
            text "{if(k == 0, 68, 35)} %" { at: sx, card.y + 68; anchor: center; size: 11; color: ink; opacity: 60% }
        }

        //  Y la columna de filas, como en la lámina: icono, título, lo que pasa
        //  debajo, y el interruptor a la derecha.
        text ajuste.1 = "Wi-Fi"
        text ajuste.2 = "Bluetooth"
        text ajuste.3 = "Concentración"
        text detalle.1 = "Casa"
        text detalle.2 = "Auriculares"
        text detalle.3 = "25 min"
        column filas { at: card.x + 24, card.y - 106; gap: 10
            repeat k in 1..4 {
                group {
                    size: 232, 58
                    prop luz = 0 ~140ms
                    zone box fila.$k { from: 0, 0; size: 232, 58; corner: 14; cursor: pointer }
                    box { from: 0, 0; size: 232, 58; corner: 14; color: mix(#1d2022, #272c2e, luz) }
                    ellipse { at: 28, 29; radius: 9; color: mint; opacity: 55% + luz * 25% }
                    text ajuste.$k { at: 50, 22; anchor: left center; size: 12.5; color: ink }
                    text detalle.$k { at: 50, 38; anchor: left center; size: 10.5; color: ink; opacity: 42% }
                    box { at: 202, 29; size: 34, 18; corner: 9; color: mix(#2f3436, mint, if(k < 3, 1, 0)) }
                    ellipse { at: 202 + if(k < 3, 7, -7), 29; radius: 7; color: #eef3f0 }
                    on enter fila.$k { luz: 1 }
                    on leave fila.$k { luz: 0 }
                }
            }
        }

        //  Abajo, lo que suena.
        box { at: card.x, card.y + 148; size: 512, 76; corner: 16; color: #1d2022 }
        body {
            gradient: radial card.x - 218, card.y + 148 radius 46, #7e9c8b, #2f4a3e
            box { at: card.x - 218, card.y + 148; size: 56, 56; corner: 12 }
        }
        text "Sin prisa" { at: card.x - 178, card.y + 140; anchor: left center; size: 12.5; color: ink }
        text "Sesión de tarde" { at: card.x - 178, card.y + 158; anchor: left center; size: 10.5; color: ink; opacity: 42% }
        //  Anterior, pausa y siguiente. Los triángulos son caminos: tres puntos.
        let by = card.y + 148
        let bx1 = card.x + 120
        let bx3 = card.x + 212
        path { at: bx1 - 7, by - 7; color: ink; move 12, 0; line 12, 14; line 0, 7; close }
        box { at: bx1 - 9, by; size: 3, 14; corner: 1.5; color: ink }
        ellipse { at: card.x + 166, by; radius: 17; color: ink; opacity: 92% }
        box { at: card.x + 162, by; size: 3.5, 13; corner: 1.75; color: #16181a }
        box { at: card.x + 170, by; size: 3.5, 13; corner: 1.75; color: #16181a }
        path { at: bx3 - 5, by - 7; color: ink; move 0, 0; line 12, 7; line 0, 14; close }
        box { at: bx3 + 9, by; size: 3, 14; corner: 1.5; color: ink }
    }

    // ── abrir y cerrar ───────────────────────────────────────────
    //  Al abrir manda la geometría y el contenido entra detrás. Al cerrar, al
    //  revés: 50 ms de fundido y luego 210 de recogida, que es lo que hace que
    //  parezca que se la traga y no que se apaga.
    on change open while open {
        card: 1 ~290ms
        content: 1 ~200ms after 90ms
    }
    on change open while not open {
        content: 0 ~50ms
        card: 0 ~210ms after 50ms
    }

    // ── el nivel ─────────────────────────────────────────────────
    //  Se dispara con lo que cambie el volumen, venga de donde venga. Y no
    //  ocurre hundida: la tecla del volumen no va dirigida a ella.
    follow nivel = sonido.volume
    on change sonido.volume while out > 0.9 { meter: 1 }
    //  Aguanta 1,1 s tras el ÚLTIMO cambio, no tras cada uno: una ráfaga de
    //  teclazos es una lectura continua y no un parpadeo por escalón. Esto es
    //  lo que pleamar no sabía decir y ahora dice: `on still`.
    on still sonido.volume for 1.1s { meter: 0 }

    // ── la vida de un aviso ──────────────────────────────────────
    //  Un aviso la saca si está hundida, y entonces la tarjeta espera a que
    //  haya salido: separarse y presentar a la vez enterraba lo uno en lo otro.
    on notice while fase == 0 and out > 0.9 { cual = cat; fase = 1; seq = seq + 1; miseq = seq; marca = marca + 1; needed = true; wanted = true; play startle; entra: 1 ~220ms }
    on notice while fase == 0 and out <= 0.9 { cual = cat; fase = 1; seq = seq + 1; miseq = seq; needed = true; wanted = true; play startle; entra: 1 ~220ms after 560ms }
    on change out > 0.9 while fase == 1 { marca = marca + 1 }
    //  Con uno ya en pantalla, el que llega va derecho a su gota. (La ráfaga
    //  apilada —tres a la vista y «+N más»— está por hacer.)
    on notice while fase != 0 { seq = seq + 1; emit direct }

    //  3,2 s para leerla, que el puntero encima detiene: al irse, vuelve a
    //  contar. Es `on still` otra vez: «cuando lleve ese rato sin que nada
    //  vuelva a empezar la lectura».
    zone box aviso_zona { at: av.x0, cy_real; size: 250, 44; corner: 14; cursor: pointer; active: fase == 1 }
    on enter aviso_zona { sobre = true }
    on leave aviso_zona { sobre = false; marca = marca + 1 }
    on press aviso_zona { emit tray }
    on still marca for 3.2s while fase == 1 and not sobre { fase = 2; mine: 1 ~220ms }
    on change mine > 0.97 while fase == 2 and mine > 0.97 { emit landed }
    on landed {
        fase = 0
        wanted = false
        entra: 0 ~16ms
        mine: 0 ~16ms after 40ms
        play gulp
    }

    // ── la cuenta atrás ──────────────────────────────────────────
    //  Ocurre DENTRO de la bolita y ANTES de arrancar el grabador, así que no
    //  sale en el vídeo. Y el número nunca llega a enseñar el cero: el cero no
    //  es una cuenta, es el momento de empezar.
    //  Al salir vuelve a cero, y así entrar SIEMPRE es un cambio de 0 a 3: el
    //  tres se lleva su rebote como el dos y el uno, sin una regla aparte que
    //  luego se dispare dos veces.
    on change face while face != count { left = 0 }
    on change face while face == count { left = 3 }
    every 1s while face == count { left = left - 1 }
    //  El rebote DECRECE con la cuenta: tres golpes cada vez más pequeños para
    //  que el último aterrice en silencio justo cuando arranca el grabador. Un
    //  empujón a la velocidad del muelle, no una animación hasta un tamaño: por
    //  eso cada golpe sale de donde estaba el anterior en vez de cortarlo, y
    //  por eso la cantidad puede depender de la cuenta —que es lo que pleamar
    //  no sabía hacer: `impulse` solo aceptaba un número escrito—.
    on change left while left > 0 { impulse pop left * 2.5 }
    //  Solo si de verdad estaba contando: al salir de la cuenta `left` vuelve
    //  a cero, y sin esto parar a mitad de cuenta la mandaba a grabar.
    on change left while left == 0 and face == count { face = rec }

    // ── grabar: la esquina ───────────────────────────────────────
    //  Ella viaja por los bordes: sale por arriba con el mismo gesto de la
    //  foto y entra por la esquina, en otra superficie. Marea esconde una
    //  ventana y enseña otra; aquí se va de verdad y llega de verdad, y en
    //  medio no hay ningún frame donde esté en los dos sitios o en ninguno
    //  mientras se la mira.
    event record
    event stop
    fact corner = false
    //  0 fuera de la pantalla, 1 metida en la esquina. Vivo: entra con un
    //  rebote pequeño contra el ángulo, que es lo que la hace «encajarse».
    prop tuck = 0 ~lively
    follow tuck = if(corner, 1, 0)

    on record { para = rincon; play retire }
    //  «Ya cuenta desde la esquina que va a ocupar».
    on gone while para == rincon {
        away: 1 ~16ms
        corner = true
        face = count
    }
    //  El grabador lo arranca la lógica, y es ella quien dice `taping`. Aquí
    //  no hay grabador, así que hace de él una espera: 300 ms con la cara de
    //  grabar puesta. Lo importante es que son DOS hechos: el disco llega con
    //  la cara, y el rojo con el grabador.
    on still face for 300ms while face == rec { taping = true }
    on stop {
        taping = false
        corner = false
        face = eye
        away: 0 ~lively after 300ms
    }

    // ── lo que responde al ratón ─────────────────────────────────
    //  Debajo de ella: la pulsación es de la zona de más arriba.
    zone box nota_conj { from: cx - 30, cy_real - 40; size: 200, 80; active: note }
    zone box cuerpo_zona { at: cx, cy_real; size: 2 * r, 2 * r + 30; corner: r; cursor: pointer }
    //  Cualquier cosa que la necesite la saca; y vuelve a hundirse tras 2,6 s de
    //  gracia, que es lo que el contrato llama gracia y aquí se dice tal cual.
    on enter cuerpo_zona { needed = true; wanted = true }
    //  180 ms de espera antes de salir: pasar por encima no es preguntar la
    //  hora. Y 300 de gracia al irse, porque el hueco entre ella y la nota es
    //  real y no puede perderse al cruzarlo. Se va si se abre el panel.
    zone box nota_zona { at: nota.x, cy_real; size: 104, 56; corner: 13; cursor: pointer; active: nota > 0.8 }
    on hover cuerpo_zona for 180ms while not open { note = true }
    on away nota_conj for 300ms { note = false }
    on change open while open { note = false }
    on press nota_zona { emit calendar }
    //  Un solo reloj de gracia para todo lo que la necesita —el puntero, la
    //  nota, la tarjeta—: 2,6 s desde que lo ÚLTIMO deja de necesitarla. Con un
    //  `away` por zona, salir de ella hacia la nota ya contaba, y se hundía con
    //  la hora en la mano.
    fact wanted = false
    on leave cuerpo_zona while not note and not open { wanted = false }
    on change note while not note { wanted = false }
    on change open while not open { wanted = false }
    on still wanted for 2.6s while not wanted and not note and not open { needed = false }
    //  Se cierra al salir del conjunto, con 320 ms de gracia para un desvío.
    zone box conjunto { at: cx + card * 300, cy_real + card.h / 2 - 8; size: 200 + card.w + 80, 2 * r + 30 + card.h; corner: 30; active: open }
    on away conjunto for 320ms { open = false }
    //  El clic abre; el roce no. Antes bastaban 450 ms de roce para que un panel
    //  entero tapara lo que estabas leyendo.
    on press cuerpo_zona { press: 1; toggle open }
    on release cuerpo_zona { press: 0 }
    // ── la esquina ───────────────────────────────────────────────
    //  Asoma el 82 %: con algo más de la mitad el ojo rojo se pasaba el rato
    //  detrás del borde, que es justo lo único para lo que sirve este modo.
    //  46 × 0,82 − 23 = 14,7: a eso del ángulo queda su centro.
    surface rincon {
        //  Ancha para el panel que le sale al acercarse, con su sombra.
        size: 260, 120
        anchor: top_right
        level: overlay
        screens: "HDMI-A-1"
        //  Abierta mientras quede algo de ella dentro: así sale deslizándose
        //  en vez de desaparecer con la ventana.
        open: tuck > 0.01

        let rx = 260 - 14.7 + (1 - tuck) * 44
        let ry = 14.7 - (1 - tuck) * 44

        //  La mirada, plegada sobre su lado visible: mirar hacia su propia
        //  mitad escondida es mirar a ninguna parte.
        prop rgaze.x = 0 ~gentle
        prop rgaze.y = 0 ~gentle
        look rgaze.x, rgaze.y at rx, ry reach 6, 3.5 within 260

        //  El reloj y «Detener», que salen DE ella al acercarse. No es un panel
        //  que aparece al lado: es el mismo cuerpo, que se estira hacia dentro de
        //  la pantalla como una gota y se separa —con su cuello a mitad de
        //  camino— hasta quedar a 8 px. Marea lo funde en 150 ms; aquí nace.
        fact cerca = false
        prop near = 0 ~lively
        follow near = if(cerca and tuck > 0.9, 1, 0)
        let p.w = 124 * near
        let p.x = rx - (23 + 8 + 62) * near
        let p.y = 23
        //  Cuánto tiempo lleva. Lo cuenta el render: un segundo es un segundo
        //  aunque la lógica esté ocupada arrancando un grabador.
        fact secs = 0
        on change taping while taping { secs = 0 }
        every 1s while taping { secs = secs + 1 }

        //  La zona de gracia va DEBAJO de todo lo demás: la pulsación es de la
        //  zona de más arriba, y declarada al final se quedaba con el clic de
        //  «Detener» y con el de ella.
        zone box alrededor { from: p.x - 70, 0; size: rx - p.x + 100, 60; active: cerca }

        body {
            color: coal
            rim: 6%
            shadow: 0, 7, 16, 34%
            box { at: p.x, p.y; size: p.w, 42 * clamp(near * 3, 0, 1); corner: 13 }
            ellipse ella { at: rx, ry; radius: 23; scale: sx + press * 0.04, sy - press * 0.05; blend: 16 * 4 * near * (1 - near) }
        }
        group {
            //  Entra tarde: hasta que el panel no se ha despegado de ella, el
            //  botón quedaría debajo de su cara.
            opacity: clamp(near * 5 - 4, 0, 1)
            move: (1 - near) * 14, 0
            text "{secs, time}" { at: p.x - 46, p.y; anchor: left center; size: 13; weight: 600; color: ink }
            prop caliente = 0 ~140ms
            box { at: p.x + 22, p.y; size: 64, 26; corner: 8; color: mix(#e0655a, #f0796a, caliente) }
            text "Detener" { at: p.x + 22, p.y; anchor: center; size: 12; weight: 600; color: #060000 }
            zone box parar { at: p.x + 22, p.y; size: 64, 26; corner: 8; cursor: pointer; active: near > 0.8 }
            on enter parar { caliente: 1 }
            on leave parar { caliente: 0 }
            on press parar { emit stop }
        }
        //  La cara va un poco hacia dentro, para que el disco quede a la vista.
        Cara(rx - 5, ry + 4, min(rgaze.x, 0), max(rgaze.y, 0))

        //  Pulsarla para.
        zone box ella_zona { at: rx, ry; size: 46, 46; corner: 23; cursor: pointer }
        on press ella_zona { press: 1; emit stop }
        on release ella_zona { press: 0 }
        //  Acercarse lo saca; y se recoge con 320 ms de gracia, porque el hueco
        //  entre ella y el panel es real y no puede perderse al cruzarlo.
        on enter ella_zona { cerca = true }
        on away alrededor for 320ms { cerca = false }
        on stop { cerca = false }
    }
}
