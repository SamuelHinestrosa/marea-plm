// Marea: la bolita, escrita con pleamar.
//
// Las medidas salen de la lámina de tamaño real (`design/concepts/
// 2026-09-12-reposo-vivo/referencia-real-limpia.png`): cuerpo de 46 px, ojos de
// 5 × 13 con las puntas redondas, separados 13 entre centros y 2,5 px por debajo
// del centro del cuerpo.
//
// Los tiempos salen del contrato (`docs/ANIMACIONES.md`), y no se negocian:
// parpadeo breve cada 5,2 s, mirada cada 11 s, y cada 12–24 s la «respiración
// de Marea» de 1,3 s —los ojos miran primero, el cuerpo sube 2 px, parpadea del
// todo, se asienta y vuelve exacto a neutral—.
//
// Todo lo de este fichero lo ejecuta el render. Aquí no hay lógica ninguna.

import "comun/paleta.plm"

scene Marea {
    permissions {
        services: "audio", "audio.*", "clock", "media", "media.*", "network", "brightness", "brightness.*"
        //  Cambiar de red o de auricular no lo sabe hacer pleamar todavía (su
        //  B15), así que lo hace la lógica con las herramientas del sistema.
        run: "nmcli", "bluetoothctl"
    }
    service clock as ahora { time: text = "--:--"; date: text }
    service audio as sonido { volume: number; muted: bool; input: number; input_muted: bool }
    service media as medios { playing: bool; title: text; artist: text }
    service network as red { online: bool; name: text; kind: text; strength: number }
    service brightness as pantalla { present: bool; level: number }

    // ── las páginas del centro de control ────────────────────────
    //  Pulsar una tarjeta abre su página, y **la página sale de la tarjeta**:
    //  crece desde su sitio hasta llenar el panel. No es una pantalla que
    //  sustituye a otra; es la misma tarjeta, abierta.
    fact pagina: ninguna | wifi | bluetooth | concentracion = ninguna
    prop pag = 0 ~240ms
    follow pag = if(pagina == ninguna, 0, 1)
    model redes max 8 { nombre: text; senal: number; puesta: bool }
    model cacharros max 8 { nombre: text; puesta: bool }
    event mirar ->                     // «mira qué hay»: la lógica lo averigua
    event elegir_red ->
    event elegir_cacharro ->

    surface {
        //  La superficie tiene que dar de sí para la tarjeta **y su sombra**: 18 px
        //  de desplazamiento más 44 de difusión, por abajo y por los lados. Si no,
        //  la sombra se corta en seco contra el borde y se ve el recorte.
        size: 820, 580
        anchor: top
        margin: 0
        screens: "HDMI-A-1"
    }

    // ── dónde vive ───────────────────────────────────────────────
    //  En reposo vive arriba y centrada; al abrirse se aparta a la izquierda para
    //  presentar la tarjeta, que es como está en la lámina del centro de control.
    let cx = 120 + (1 - max(card, tray)) * 240
    //  Abierta, baja a la altura de la cabecera de la tarjeta, como en la lámina.
    let cy = 46 + max(card, tray) * 46
    let r = 23                        // la mitad de los 46 px de la lámina

    // ── lo que la mueve ──────────────────────────────────────────
    //  `pose` es lo que un gesto lleva de la mano: al acabar vuelve sola a su
    //  base, y eso es lo que hace que la respiración «regrese exacto a neutral».
    pose body.y = 0                   // cuánto sube el cuerpo
    pose lid = 1                      // los párpados: 1 abiertos, 0 cerrados
    pose eyes = 13                    // lo altos que son los ojos
    pose look.y = 0                   // la mirada dentro de la cara
    pose tilt = 0                     // la inclinación del cuerpo
    pose sx = 1                       // lo que se estira: a lo ancho
    pose sy = 1                       // y a lo alto
    pose shut = 0                     // el obturador: 1 cerrado

    prop gaze.x = 0 ~gentle           // hacia dónde miran, siguiendo al ratón
    prop gaze.y = 0 ~gentle
    prop press = 0 ~quick             // la compresión bajo el clic

    //  El viaje de salir del borde y volver: 620 ms, que es lo que dice el
    //  contrato. Una gota que se va en 200 ms es una gota que nadie vio irse.
    fact hidden = true                // «meterse en el borde», encendido
    fact needed = false               // algo la reclama: un aviso, el puntero…
    prop out = 0 ~620ms               // 0 hundida, 1 separada del todo

    //  La tarjeta. Dos cosas que viajan por separado, y ahí está el truco: al
    //  abrir manda la geometría y el contenido la sigue; al cerrar se funde
    //  primero el contenido y **luego** se recoge la geometría.
    fact open = false
    // ── los avisos ───────────────────────────────────────────────
    //  «Todo llega, tú decides»: llegar no abre nada. Entra una tarjeta pequeña
    //  a su lado, ella se sobresalta y la mira, se queda lo que hace falta para
    //  leerla y luego se estrecha hasta ser una gota del color de su categoría,
    //  que vuela por una curva a su hombro. Al llegar, un trago.
    event notice                       // llega uno: antes se dicen `cat`, `who` y `line`
    event landed
    event tray ->                      // pulsar la tarjeta: la lógica abre la bandeja
    fact cat = 1                       // 1 mensajes · 2 trabajo · 3 calendario · 4 sistema
    fact cual = 1                      // la del que se está leyendo: `cat` puede cambiar mientras
    fact miseq = 0                     // y su turno de llegada: aterriza tarde, pero llegó antes
    event direct                       // uno que llega con otro en pantalla
    text who = ""
    text line = ""
    fact fase = 0                      // 0 nada · 1 leyéndose · 2 volando
    fact sobre = false                 // el puntero encima: detiene la lectura
    fact marca = 0                     // cada vez que la lectura vuelve a empezar
    fact seq = 0                       // para saber cuál es el más reciente
    fact cuantos = 1                   // cuántas trae la ráfaga
    // ── la bandeja ───────────────────────────────────────────────
    //  «Todo llega, tú decides». Llegar no la abre: se abre pulsándola a ella,
    //  la vista previa, una gota o la tarjeta que llega.
    fact bandeja = false
    event abrir_bandeja
    event cerrar_bandeja
    event resolver ->                  // con cuál, de carga: la lógica la marca leída
    event descartar ->                 // y esta se tira: no vuelve, ni manda gota
    event abrir_aviso ->               // un toque: que la lógica lo abra donde viva
    //  «Deshacer» durante 5 s, con una mecha que se consume. Cinco segundos
    //  exactos y a ritmo constante no los da un muelle: los da un gesto, que es
    //  una línea de tiempo con su curva. `linear` es lo que hace que una mecha
    //  parezca una mecha y no algo que frena al final.
    // ── el Remanso ───────────────────────────────────────────────
    //  No molestar, pero despierta. «Remanso no significa apagada»: sigue aquí,
    //  atenta, y guarda los avisos mientras tú te concentras.
    //
    //  La membrana comparte **exactamente** su diámetro: entrar no agranda su
    //  silueta. Debajo de la línea de agua se guardan las perlas, una por
    //  categoría, y la marea cambia de pendiente despacio —ida y vuelta en
    //  7,6 s— sin mover ni el cuerpo ni las perlas.
    fact remanso = false
    fact queda = 0                     // los minutos que le quedan
    fact mirado = false                // si ya ha mirado esta urgencia
    event entrar_remanso
    event salir_remanso
    event ver_reglas ->
    prop calma = 0 ~320ms              // 0 despierta, 1 en Remanso
    prop mirada = 0 ~260ms             // la urgencia que se mira, sin abrir nada
    prop dibuja = 0 ~320ms             // la ola que dibuja la burbuja, una vez
    prop resumen = 0 ~500ms            // al volver, un único resumen
    //  La marea: una ida y vuelta en 7,6 s. Nada de bucles nerviosos; esto es
    //  lo único que se mueve, y se mueve como el agua.
    pose marea = 0
    wave marea = 1 at 0.827
    //  Entrar dura 320 ms y despertar 500: no es el mismo viaje, así que no es
    //  el mismo muelle. Y la ola que dibujó la membrana la deshace al salir,
    //  con el mismo tiempo que tarda ella en despertarse.
    on entrar_remanso { remanso = true; mirado = false; calma: 1 ~320ms; dibuja: 0 ~16ms; dibuja: 1 ~320ms after 30ms }
    on salir_remanso { remanso = false; queda = 0; calma: 0 ~500ms; dibuja: 0 ~500ms; resumen: 1 ~500ms; resumen: 0 ~300ms after 4200ms }
    //  Y se acaba solo: un minuto menos cada minuto, y al llegar a cero sale
    //  ella. Un «no molestar» que hay que acordarse de quitar se queda puesto
    //  toda la tarde, y entonces ya no es un remanso sino un tapón.
    every 60s while remanso and queda > 0 { queda = queda - 1 }
    on change queda while remanso and queda < 1 { emit salir_remanso }

    //  «Ha llegado algo urgente»: lo dice la lógica. La cara se alarma con una
    //  admiración y un salto corto; los números son los del gesto `cupo` de
    //  Marea, por 46/56.
    event urge
    gesture alarmarse reflex {
        60ms in_quad   { sx: 1.08; sy: 0.90; body.y: 2.5 }
        130ms out_quad { sx: 0.96; sy: 1.06; body.y: -3.3 }
        110ms in_quad  { sx: 1.02; sy: 0.98 }
        180ms
    }
    fact deshacer = false
    fact ultima = 0                    // qué fila se resolvió, para devolverla
    event se_apago
    pose mecha = 1
    gesture arde state {
        5s linear { mecha: 0 }
        10ms emit se_apago
    }
    on se_apago { deshacer = false }

    //  Un urgente abre la bandeja sin quitar el teclado, y la cara se alarma:
    //  una admiración y un salto corto. **Una vez por episodio**, desde el
    //  primero hasta que no queda ninguno: un aviso que salta cada vez es un
    //  aviso que se acaba tapando con una ventana.
    on urge while not remanso and face == eye { face = alerta; play alarmarse; emit abrir_bandeja }
    //  En Remanso una urgencia permitida **no abre la bandeja ni roba el foco**:
    //  aparece una perla ámbar sobre la membrana y solo el ojo de al lado se
    //  vuelve redondo para mirarla. 1,1 s, y a lo suyo otra vez.
    //  Una vez por episodio, igual que la cara alarmada: lo que molesta de un
    //  aviso urgente no es el primero, es el cuarto.
    on urge while remanso and not mirado { mirado = true; mirada: 1; mirada: 0 ~260ms after 840ms }
    on still hay_urgente for 1.6s while not hay_urgente and face == alerta { face = eye }
    on still hay_urgente for 1.6s while not hay_urgente { mirado = false }
    //  De qué es cada fila. Lo pondría la lógica; aquí se nace con algo.
    prop tray = 0 ~240ms               // 0 dentro de ella, 1 tarjeta entera
    prop carril = 0 ~240ms             // las gotas: 0 en su hombro, 1 en el carril
    //  Cada fila llega un poco después que la de arriba: eso es el oleaje.
    //  Y al resolverla, se va a la derecha y suelta una gota que vuelve.
    repeat k in 1..6 {
        fact viva.$k = true
        fact catfila.$k = 1
        //  Un urgente no se agrupa: fila propia, arriba y en ámbar.
        fact urg.$k = false
        prop sube.$k = 0 ~lively
        prop fuera.$k = 0 ~220ms
        prop suelta.$k = 0 ~380ms
        //  Lo que la ha arrastrado el dedo. Si no llega al umbral, vuelve sola.
        prop tira.$k = 0 ~lively
        prop toca.$k = 0 ~140ms
        //  Cuántas vivas tiene encima: su sitio en la lista. Al resolver una,
        //  las de abajo suben a ocupar el hueco en vez de dejarlo ahí.
        prop hueco.$k = 0 ~calm
    }
    follow hueco.1 = if(viva.2 and urg.2 and not urg.1, 1, 0) + if(viva.3 and urg.3 and not urg.1, 1, 0) + if(viva.4 and urg.4 and not urg.1, 1, 0) + if(viva.5 and urg.5 and not urg.1, 1, 0)
    follow hueco.2 = if(viva.1 and (urg.1 or not urg.2), 1, 0) + if(viva.3 and urg.3 and not urg.2, 1, 0) + if(viva.4 and urg.4 and not urg.2, 1, 0) + if(viva.5 and urg.5 and not urg.2, 1, 0)
    follow hueco.3 = if(viva.1 and (urg.1 or not urg.3), 1, 0) + if(viva.2 and (urg.2 or not urg.3), 1, 0) + if(viva.4 and urg.4 and not urg.3, 1, 0) + if(viva.5 and urg.5 and not urg.3, 1, 0)
    follow hueco.4 = if(viva.1 and (urg.1 or not urg.4), 1, 0) + if(viva.2 and (urg.2 or not urg.4), 1, 0) + if(viva.3 and (urg.3 or not urg.4), 1, 0) + if(viva.5 and urg.5 and not urg.4, 1, 0)
    follow hueco.5 = if(viva.1 and (urg.1 or not urg.5), 1, 0) + if(viva.2 and (urg.2 or not urg.5), 1, 0) + if(viva.3 and (urg.3 or not urg.5), 1, 0) + if(viva.4 and (urg.4 or not urg.5), 1, 0)
    follow hay_urgente = if(viva.1 and urg.1, 1, 0) + if(viva.2 and urg.2, 1, 0) + if(viva.3 and urg.3, 1, 0) + if(viva.4 and urg.4, 1, 0) + if(viva.5 and urg.5, 1, 0)
    fact catfila.2 = 3
    fact catfila.3 = 2
    fact catfila.4 = 4
    fact catfila.5 = 1
    text fila.1.app = "TELEGRAM"
    text fila.2.app = "CALENDARIO"
    text fila.3.app = "CORREO"
    text fila.4.app = "SISTEMA"
    text fila.5.app = "TELEGRAM"
    text fila.1.que = "Ana Ruiz"
    text fila.2.que = "Revisión de diseño"
    text fila.3.que = "Factura de septiembre"
    text fila.4.que = "Copia de seguridad hecha"
    text fila.5.que = "Grupo de la obra"
    text fila.1.mas = "¿Comemos hoy? Tengo mesa a las dos"
    text fila.2.mas = "en 10 minutos · sala grande"
    text fila.3.mas = "vence el 30"
    text fila.4.mas = "412 ficheros, 2,1 GB"
    text fila.5.mas = "6 mensajes sin leer"
    text fila.1.hora = "ahora"
    text fila.2.hora = "2 min"
    text fila.3.hora = "1 h"
    text fila.4.hora = "3 h"
    text fila.5.hora = "ayer"
    prop entra = 0 ~220ms              // la tarjeta, entrando
    //  Una por tarjeta del montón: vuelan juntas pero no a la vez.
    repeat j in 0..3 { prop vuela.$j = 0 ~280ms }
    prop atenta = 0 ~gentle            // mirando la tarjeta
    follow atenta = if(fase == 1, 1, 0)

    let azul = #6fb1e6
    let lila = #a68be4
    let verde = #8fd1ae
    let ambar = #e3a35c
    //  Cuántos hay de cada una, y cuándo llegó el último: se declaran antes
    //  que las gotas porque cada gota mira a las otras tres.
    repeat k in 1..5 {
        fact n.$k = 0
        fact last.$k = 0
        //  La gota late cuando cae algo suyo, y en Remanso late su perla: es el
        //  mismo golpe, porque es la misma noticia contada en otro sitio.
        prop late.$k = 0 ~lively
        //  Y la perla, que aparece cuando hay algo de su categoría guardado.
        prop perla.$k = 0 ~320ms
        follow perla.$k = if(n.$k > 0, 1, 0)
    }
    //  Si queda alguno urgente. Mientras lo haya, la cara sigue alarmada.
    prop hay_urgente = 0 ~16ms

    //  Cuántos hay esperando, de todas las categorías: es lo que decide si al
    //  pasar por encima sale la hora o sale el abanico. Va en un `prop` porque
    //  un `let` no ve los hechos que declara un `repeat` —se resuelve antes—, y
    //  con un muelle de un frame para que no arrastre.
    prop pendientes = 0 ~16ms
    follow pendientes = n.1 + n.2 + n.3 + n.4

    //  La vista previa. Con avisos pendientes, pasar por encima abre las gotas
    //  en abanico debajo de ella, con el icono de su categoría, y enseña el más
    //  reciente. **Ocupa el sitio de la nota de la hora**: o una, o la otra.
    prop abanico = 0 ~160ms

    //  La nota de la hora.
    fact note = false
    event calendar ->                  // un clic en ella: la lógica abre el calendario
    //  Lo que la tarjeta le pide a la lógica. Aquí no hay lógica, así que se
    //  quedan dichos: la frontera está escrita, que es lo que importa.
    event mute_salida ->
    event mute_micro ->
    event tocar_pausa ->
    event anterior ->
    event siguiente ->
    event ajustes ->
    event conmutar ->                  // con cuál de las tres, de carga
    //  Arrastrar un nivel manda A DÓNDE ha ido el dedo, de 0 a 1. Dos sucesos
    //  y no uno con la pista de carga, porque una carga es un número y aquí
    //  hacen falta dos cosas: cuál y cuánto.
    event mover_brillo ->
    event mover_volumen ->
    event abrir ->                     // con cuál de las seis, de carga
    repeat k in 1..7 {
        fact puesta.$k = false
        prop encendida.$k = 0 ~180ms
        follow encendida.$k = if(puesta.$k, 1, 0)
    }
    //  Y la primera la enciende la red, no un hecho que alguien tenga que poner.
    follow encendida.1 = if(red.online, 1, 0)
    //  Y la tercera la enciende el Remanso: la tarjeta no guarda su propio
    //  interruptor, enseña el que ya hay. Dos verdades del mismo estado es
    //  como se acaba con una tarjeta encendida y la bolita despierta.
    follow encendida.3 = if(remanso, 1, 0)
    prop nota = 0 ~190ms
    follow nota = if(note and not open and not remanso and face == eye and out > 0.9 and fase == 0 and pendientes < 1, 1, 0)
    follow abanico = if(note and not open and not bandeja and not remanso and face == eye and out > 0.9 and fase == 0 and pendientes > 0, 1, 0)
    //  Y en Remanso, la cápsula: ocupa el mismo sitio que la hora.
    prop capsula = 0 ~160ms
    //  Abre en 160 y se repliega en 140, que es lo que pide el contrato. Un
    //  `follow` no sabe de qué lado viene, así que quien lo dice son dos
    //  reglas sobre lo mismo: la ida y la vuelta no son el mismo viaje.
    let cap.quiere = note and remanso and out > 0.9
    on change cap.quiere while cap.quiere { capsula: 1 ~160ms }
    on change cap.quiere while not cap.quiere { capsula: 0 ~140ms }
    let nota.x = cx + (23 + 14 + 52) * nota
    //  La cápsula del Remanso y el resumen ocupan el mismo sitio que la nota, y
    //  por eso nacen igual: del centro de ella, deslizándose a la derecha hasta
    //  quedar a 11 px. Su medio ancho va en la cuenta, como en la nota.
    let cap.x = cx + (23 + 11 + 104) * capsula
    let res.x = cx + (23 + 11 + 98) * resumen

    prop card = 0 ~290ms
    prop content = 0 ~200ms

    //  El nivel en la cara. El volumen lo trae el sistema: ni una línea de
    //  lógica, y por eso el deslizador del panel y la tecla del teclado se ven
    //  exactamente igual desde aquí —que es justo lo que pide el contrato—.
    prop meter = 0 ~180ms             // 0 cara, 1 barra
    prop nivel = 0 ~quick             // lo que marca la barra
    prop micro = 0 ~quick             // y lo que marca la del micrófono
    follow micro = sonido.input
    prop brillo = 0 ~quick            // y la del brillo de la pantalla
    follow brillo = pantalla.level

    //  ── lo que la cara puede ser ────────────────────────────────
    //  Un hecho con tipo: el compilador comprueba contra qué se compara, así
    //  que `face == lupa` no pasa de la primera lectura.
    fact face: eye | count | camera | rec | alerta = eye
    fact left = 0                     // lo que queda de la cuenta
    fact taping = false               // el grabador corriendo DE VERDAD

    prop num = 0 ~260ms               // 0 cara, 1 número
    prop cam = 0 ~220ms               // 0 cara, 1 cámara
    prop dot = 0 ~260ms               // 0 cara, 1 disco
    prop alarma = 0 ~180ms            // 0 cara, 1 admiración
    prop red = 0 ~200ms               // el rojo, que es otra cosa que el disco
    prop pop = 0 ~lively              // el rebote de la cuenta

    //  Cada estado es un muelle que sigue a su hecho. Por eso uno puede
    //  interrumpir a otro a mitad de camino y lo único que pasa es que la
    //  forma se dobla: no hay dos animaciones peleándose por los mismos ojos.
    follow num = if(face == count, 1, 0)
    follow cam = if(face == camera, 1, 0)
    follow dot = if(face == rec, 1, 0)
    follow alarma = if(face == alerta, 1, 0)
    follow red = if(taping, 1, 0)

    // ── reposo vivo ──────────────────────────────────────────────
    //  Parpadeo breve, cada 5,2 s. Y la mirada, que sigue al ratón de cerca.
    blink lid every 5.2s for 120ms
    look gaze.x, gaze.y at cx, cy reach 6, 3.5 within 260

    //  La respiración de Marea. Ambiental: cualquier otro gesto la corta.
    gesture breathe ambient {
        //  Primero miran los ojos: es lo que la hace parecer suya y no un tic.
        220ms in_out_sine        { look.y: -1.2 }
        //  El cuerpo sube dos píxeles, ni uno más.
        320ms out_quad           { body.y: -2; look.y: -0.6 }
        //  Y parpadea del todo mientras está arriba.
        180ms in_out_sine        { lid: 0; body.y: -2 }
        200ms in_out_sine        { lid: 1; body.y: -1.4 }
        //  Se asienta con una asimetría mínima, y vuelve a neutral.
        380ms out_back           { tilt: 0.012 }
    }
    every 12s..24s { play breathe }

    //  El respingo: salta 8 px sin anticipar, con los ojos muy abiertos,
    //  aterriza elástico y rebota corto. Los números de Marea, por 46/56.
    gesture startle reflex {
        75ms out_cubic            { eyes: 16.4; sx: 0.90; sy: 1.13; body.y: -2.5 }
        105ms out_quad hold 90ms  { eyes: 16.4; sx: 0.98; sy: 1.04; body.y: -6.6 }
        145ms in_quad             { eyes: 14.8; sx: 0.96; sy: 1.06 }
        100ms out_quad            { eyes: 14.8; sx: 1.10; sy: 0.82; body.y: 3.3 }
        130ms out_quad            { eyes: 14; sx: 0.98; sy: 1.04; body.y: -2.5; tilt: 0.07 }
        120ms                     { eyes: 14; sx: 1.02; sy: 0.96; body.y: 0.8; tilt: 0.05 }
        160ms hold 100ms          { eyes: 14; tilt: 0.05 }
        200ms
    }
    //  El trago, cuando la gota llega a su hombro.
    gesture gulp reflex {
        90ms out_quad   { sx: 1.06; sy: 0.94; body.y: 1 }
        180ms out_back
    }

    follow out = if(hidden and not needed, 0, 1)

    // ── la fotografía ────────────────────────────────────────────
    //  No se apaga de golpe antes de que se congele la pantalla: anticipa 70 ms,
    //  se estira y SALE por el borde de arriba en 150. Los números son los de
    //  Marea, por 46/56; el último sube más que allí porque esta superficie no
    //  se esconde: aquí es ella la que tiene que quedar fuera del todo.
    event snap                         // alguien pide una foto
    event gone                         // ya no está en el encuadre
    prop away = 0 ~quick               // 1 mientras espera arriba, fuera de la vista

    gesture retire state {
        70ms out_quad           { eyes: 14.8; sx: 0.94; sy: 1.12; body.y: -3.3 }
        150ms in_cubic          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
        //  `emit` suena al EMPEZAR su fotograma, así que va en uno propio: el
        //  aviso de «ya no estoy» tiene que llegar cuando ya no está.
        30ms emit gone          { eyes: 13.1; sx: 0.78; sy: 1.30; body.y: -84 }
    }
    //  Sale igual para dos cosas, y al llegar arriba hace una u otra.
    fact para: foto | rincon = foto
    on snap { para = foto; play retire }

    //  El disparo. El obturador es una pose y el clic un gesto: cierra en 80,
    //  aguanta, abre en 170 —los tiempos de Marea— y devuelve la cara. Y un
    //  culatazo mínimo del cuerpo al cerrar, que allí no está: una cámara que
    //  dispara sin moverse es un icono, no una cámara.
    event shoot
    event taken
    gesture click state {
        80ms out_quad hold 10ms  { shut: 1; sx: 1.05; sy: 0.95 }
        170ms out_back           { shut: 0 }
        120ms
        10ms emit taken
    }
    on shoot while face == camera { play click }
    on taken { face = eye }
    //  Fuera ya, se queda fuera —el gesto devuelve la pose a su base, y sin
    //  esto volvería a caer en el mismo frame— y cambia de cara donde nadie la
    //  ve. 200 ms de margen, que es lo que el compositor tarda en retirar la
    //  capa: están medidos en Marea, con 90 salía un fantasma suyo en la foto.
    //  Y vuelve cayendo con un muelle vivo, que rebota un pelo al aterrizar:
    //  no «aparece» con la cámara puesta, regresa.
    on gone while para == foto {
        away: 1 ~16ms
        face = camera
        away: 0 ~lively after 220ms
    }

    //  Hundida asoma algo menos de la mitad; separada cuelga a su propia altura.
    //  Cuánto se mete. El contrato dice «algo menos de la mitad», y con eso el
    //  borde de arriba del ojo caía 1,25 px POR ENCIMA del borde de la pantalla:
    //  se le veía el ojo cortado por abajo. Asoma 29 de 46, que son casi dos
    //  tercios, y se le ve la cara. Es una desviación del contrato a propósito.
    let sube = if(hidden, (1 - out) * 40, 0)
    //  Y al abrir la bandeja sube 5 px, que es lo que dice el contrato.
    let cy_real = cy + body.y - sube - away * 84 - 5 * tray
    //  La cápsula, 12 px más abajo que ella: mide 92 de alto y centrada en su
    //  centro se salía por el borde de arriba.
    let cap.y = cy_real + 12

    //  El cuello: mínimo en reposo y máximo a mitad de la separación, que es una
    //  campana. Al final no queda nada y el hilo se rompe solo.
    let cuello = 30 * 4 * out * (1 - out) * if(hidden, 1, 0)

    //  Y el agua no es una lámina quieta. Mientras la sujeta se estira hacia
    //  ella, y cuando el hilo se rompe la superficie se va hacia arriba de
    //  golpe y rebota un par de veces antes de quedarse plana. Eso es lo que la
    //  hace leerse como agua y no como una cortina con un agujero.
    //  Un muelle propio, poco frenado: el agua no se queda quieta a la primera.
    //  420 y 13 son un cuarto de segundo de periodo y dos botes que se ven.
    spring chapoteo = 420, 13
    prop rebote = 0 ~chapoteo
    //  Una campana, como el cuello: plana pegada al borde, lo más estirada a
    //  mitad del viaje, plana otra vez cuando ya la ha soltado.
    let tension = 4 * out * (1 - out)
    let cuelga = max((16 * tension + rebote) * if(hidden, 1, 0), 0.3)
    //  El hilo se rompe cerca del final —ahí el hueco ya puede con el cuello—,
    //  y es entonces cuando la superficie da el tirón.
    //  Y el rizo que se va: del sitio por donde salió ella salen dos bultos que
    //  recorren la lámina achicándose. El tirón solo se siente donde estaba; esto
    //  es lo que cuenta que la superficie entera es agua.
    prop onda = 1 ~900ms
    let onda.x = 10 + 48 * onda
    //  Sube en el primer palmo y se va apagando: un rizo se ve cuando ya se ha
    //  separado del sitio donde nació, no encima de él.
    let onda.alto = 12 * (1 - onda) * clamp(onda * 6, 0, 1) * if(hidden, 1, 0)
    //  Y la gota que se queda: al romperse el hilo, un poco de ella no se va
    //  con ella. Cuelga un momento del borde y el agua se la traga.
    prop gota = 0 ~520ms
    //  Y ELLA es la gota. Colgando del borde se estira —la superficie tira de
    //  ella y la afila—, y al soltarse se sacude hasta volver a ser redonda,
    //  como hace una gota de verdad cuando se desprende. Esto es lo que de
    //  verdad se ve: son 46 px meneándose, no 12 de borde.
    prop menea = 0 ~chapoteo
    let estira = tension * 0.11 * if(hidden, 1, 0)
    let gotea = estira + menea * 0.012
    let gota.r = 5.5 * gota * if(hidden, 1, 0)
    on change out > 0.84 while out > 0.84 and hidden {
        impulse rebote -150
        impulse menea -340
        onda: 0 ~16ms
        onda: 1 ~900ms after 30ms
        gota: 1 ~16ms
        gota: 0 ~520ms after 60ms
    }
    //  Y al revés: cuando vuelve, el agua la agarra antes de tragársela. Tira de
    //  ella hacia arriba —se afila— y la superficie se hunde a su alrededor.
    on change out < 0.84 while out < 0.84 and hidden {
        impulse menea 190
        impulse rebote 40
    }

    // ── el cuerpo ────────────────────────────────────────────────
    //  El agua del borde y la bolita son una sola silueta: el cuello no se
    //  dibuja, sale de fundirlas. Por eso se afina y rompe sin que nadie lo
    //  calcule, y por eso es cóncavo.
    body {
        color: coal
        rim: 6%
        shadow: 0, 7, 16, 34%
        box agua { from: cx - 70, -70; size: 140, 70 * if(hidden, 1, 0) }
        //  El bulto que el agua hace alrededor de ella: es la misma lámina, que
        //  se estira. Fundido con ella y con la bolita, así que los tres son una
        //  silueta y el cuello sale de las distancias, no de dibujar un cuello.
        //  El fundido se va con el bulto: si no, un bulto de medio píxel seguía
        //  abultando la lámina y quedaba un lunar en el borde con ella ya suelta.
        ellipse tirante { at: cx, 0; radius: 30; scale: 1, cuelga / 30; blend: 16 * clamp(cuelga / 6, 0, 1) }
        ellipse rizo.i { at: cx - onda.x, 0; radius: 9; scale: 1, onda.alto / 9; blend: 8 * clamp(onda.alto / 3, 0, 1) }
        ellipse rizo.d { at: cx + onda.x, 0; radius: 9; scale: 1, onda.alto / 9; blend: 8 * clamp(onda.alto / 3, 0, 1) }
        ellipse gota_atras { at: cx, gota.r * 0.7; radius: gota.r; blend: 7 * clamp(gota.r / 3, 0, 1) }
        ellipse cuerpo {
            at: cx, cy_real
            radius: r
            rotate: tilt
            scale: (sx + press * 0.04) * (1 - gotea), (sy - press * 0.05) * (1 + gotea)
            blend: cuello
        }
        //  La nota de la hora, que sale de DETRÁS de ella: nace en su centro con
        //  ancho cero y se desliza a la derecha hasta quedar a 14 px, con su
        //  cuello a mitad de camino. Es parte del mismo cuerpo, así que la
        //  sombra es una sola y el borde también.
        //  La bandeja **brota de ella**: no es una tarjeta que aparece al lado,
        //  es su propio cuerpo estirado. Va en este mismo `body`, así que
        //  comparten silueta, sombra y filo, y entre las dos hay un cuello que
        //  nadie dibuja: sale de fundirlas, como el del borde del agua.
        box bandeja_caja {
            at: tray.x, tray.y
            size: tray.w, tray.h
            corner: 22 * tray
            blend: 30 * 4 * tray * (1 - tray) + 24 * tray
        }
        //  Y el centro de control igual: brota de ella con su cuello, y cuando
        //  está abierto queda unido por un fillet. Un panel que aparece al lado
        //  es un panel; esto es ella, estirada.
        box tarjeta {
            at: card.x, card.y
            size: card.w, card.h
            corner: 22 * card
            blend: 30 * 4 * card * (1 - card) + 24 * card
        }
        box nota_caja {
            at: nota.x, cy_real
            size: 104 * clamp(nota * 1.6, 0, 1), 56 * clamp(nota * 2.4, 0, 1)
            corner: 13
            blend: 18 * 4 * nota * (1 - nota)
        }
        //  La cápsula del Remanso, igual: es lo que dice cuando le preguntas
        //  pasando por encima, así que sale de donde sale la hora y del mismo
        //  modo. Una cápsula que aparece al lado sería otra cosa, puesta ahí.
        box capsula_caja {
            at: cap.x, cap.y
            size: 208 * clamp(capsula * 1.6, 0, 1), 92 * clamp(capsula * 2.4, 0, 1)
            corner: 16
            blend: 18 * 4 * capsula * (1 - capsula)
        }
        //  Y el resumen al volver: lo último que hace el Remanso es devolverle
        //  lo que guardó, y se lo devuelve saliendo de ella.
        box resumen_caja {
            at: res.x, cy_real
            size: 196 * clamp(resumen * 1.6, 0, 1), 40 * clamp(resumen * 2.4, 0, 1)
            corner: 20
            blend: 18 * 4 * resumen * (1 - resumen)
        }
    }

    //  Lo que lleva escrito. La hora la trae el sistema; aquí no hay lógica.
    group {
        opacity: clamp(nota * 4 - 3, 0, 1)
        move: (1 - nota) * -12, 0
        text ahora.time { at: nota.x - 39, cy_real - 9; anchor: left center; size: 21; weight: 600; color: #f6f6f5 }
        text "{upper(ahora.date)}" { at: nota.x - 39, cy_real + 13; anchor: left center; size: 10; color: #8b8f95 }
    }

    // ── la cara ──────────────────────────────────────────────────
    //  Recortada al cuerpo: lo que se salga de la bolita no existe. Es lo que
    //  deja que los ojos se conviertan en otra cosa sin salirse de ella.
    //
    //  Todo lo que sigue es UNA cadena: el ojo de siempre, y cada estado
    //  tirando de él. Se escribe así y no con pesos sueltos porque cada línea
    //  dice qué hace ese estado, y porque dos muelles a mitad de camino nunca
    //  suman uno. La cara no se cambia por otra: se dobla hasta ser otra cosa.
    //
    //  Las medidas salen de la lámina de Marea, que dibuja la cara en un
    //  espacio de 56; aquí la bolita mide 46, así que todo va por 46/56.

    //  Es un componente porque ella puede estar en dos sitios: arriba, y metida
    //  en la esquina mientras graba. La misma cara, los mismos muelles; lo único
    //  que cambia es dónde está y hacia dónde puede mirar.
    component Cara(x: number, y: number, gx: number, gy: number, baja: number = 0) {
        //  Cuando manda otra cosa, el párpado deja de contar: una cámara no
        //  parpadea y un número tampoco.
        let manda = clamp(meter + num + cam + dot, 0, 1)
        let parpado = lid + (1 - lid) * manda

        //  1. El ojo, y el nivel tumbándolo. (Medido en «El nivel en la cara».)
        let o.w = 5 + 8 * meter
        let o.h = eyes * parpado * (1 - meter) + 5 * meter
        let o.sep = 6.5 - 4 * meter

        //  2. La cuenta atrás. Los dos ojos se van al centro y se redondean hasta
        //  ser UNA gota —se funden de verdad, que para eso son un cuerpo—, y
        //  entonces la gota **se abre como un diafragma**: crece mientras se le
        //  come el centro, se queda en un anillo, y dentro estaba el número. No es
        //  que los ojos se escondan y aparezca un número encima; es que el número
        //  estaba detrás de ellos y los ojos se abren para enseñarlo.
        let junta = clamp(num * 2, 0, 1)
        let abre = clamp(num * 2 - 1, 0, 1)
        let c.w = o.w + (9 - o.w) * junta
        let c.h = o.h + (9 - o.h) * junta
        let c.sep = o.sep * (1 - junta)
        //  18 y no 30: el anillo se queda en algo más de media bolita. Con 30 casi
        //  la llenaba, y en 260 ms eso no es un diafragma, es un fogonazo.
        let g.w = c.w + 18 * abre
        let g.h = c.h + 18 * abre

        //  3. La cámara. El izquierdo se abre en el objetivo y el derecho se
        //  estira alrededor hasta ser el cuerpo; los dos al centro de la cara.
        //  El objetivo mide 13 de la lámina, y 5 con el obturador cerrado.
        let ojo.l = 10.7 - 5.4 * shut
        let l.w = g.w + (ojo.l - g.w) * cam
        let l.h = g.h + (ojo.l - g.h) * cam
        let r.w = g.w + (24.6 - g.w) * cam
        let r.h = g.h + (17.3 - g.h) * cam
        let sep = c.sep * (1 - cam) * (1 - alarma)

        //  4. El disco de grabar: el ojo izquierdo, y solo él. El derecho sigue
        //  siendo un ojo y sigue al puntero, que es lo que la mantiene viva
        //  mientras dura. El disco se queda donde estaba el ojo, no se centra.
        let d.w = l.w + (9 - l.w) * dot
        let d.h = l.h + (9 - l.h) * dot

        //  5. La admiración: el palo es el ojo izquierdo y el punto el derecho,
        //  los dos centrados, porque un «!» descentrado no es un «!». Se van al
        //  medio, y uno se estira mientras el otro se hace punto.
        let a.w = d.w + (4.1 - d.w) * alarma
        let a.h = d.h + (12.3 - d.h) * alarma
        let a.rw = r.w + (4.1 - r.w) * alarma
        let a.rh = r.h + (4.1 - r.h) * alarma

        //  6. En Remanso los ojos bajan a dos trazos relajados. No se cierran:
        //  sigue aquí, atenta. Cerrarlos sería dormir, que es otra cosa.
        let z.w = a.w + (7.4 - a.w) * calma
        let z.h = a.h + (2.5 - a.h) * calma
        let z.rw = a.rw + (7.4 - a.rw) * calma
        let z.rh = a.rh + (2.5 - a.rh) * calma
        //  Y el de al lado de la perla se abre redondo para mirarla. Solo ese:
        //  el otro sigue en su trazo, porque no ha pasado nada más.
        let z.rw2 = z.rw + (9.5 - z.rw) * mirada
        let z.rh2 = z.rh + (9.5 - z.rh) * mirada

        let ojo.y = y + 2.5
        let l.x = x - sep
        let r.x = x + sep
        //  Redondo cuando es redondo: la mitad del lado corto sale pill de pie,
        //  pill tumbado, gota, objetivo y disco sin decirlo cinco veces. El cuerpo
        //  de la cámara es el único que se aparta, porque tiene esquina propia.
        let l.corner = min(z.w, z.h) / 2
        let r.corner = min(z.rw2, z.rh2) / 2 + (4.9 - min(z.rw2, z.rh2) / 2) * cam
        //  Y el puente entre los dos: campana, como la del menisco. Máximo justo
        //  cuando se tocan —a mitad del viaje del nivel, y al juntarse en la gota—
        //  y nada en los extremos.
        let ojo.fusion = 6 * 4 * meter * (1 - meter) + 7 * junta * (1 - cam)

        group {
            clip inset 1 ellipse { at: x, y; radius: 23 }
            move: gx, gy + look.y + baja

            //  Los ojos, que aquí son todo: pista del nivel, gota de la cuenta,
            //  objetivo y cuerpo de la cámara, y sitio del disco rojo. Se
            //  oscurecen tumbados porque una pista blanca con menta encima no se
            //  lee como un nivel; y se van cuando la gota se abre.
            body {
                color: mix(ink, #34373a, meter)
                box { at: l.x, ojo.y - 2.8 * alarma; size: z.w, z.h; corner: l.corner; blend: ojo.fusion }
                box { at: r.x, ojo.y + 6.2 * alarma; size: z.rw2, z.rh2; corner: r.corner; blend: ojo.fusion }
            }

            //  Lo lleno del nivel es **la misma pista**, pintada otra vez y
            //  recortada por la izquierda. Así la menta tiene la forma exacta de la
            //  barra —con sus puntas— sin dibujar ni una geometría más. En su
            //  propio grupo: un recorte llega hasta el final del grupo donde vive.
            group {
                clip inset 0 box { from: x - 9, ojo.y - 4; size: 18 * nivel, 8 }
                body {
                    color: mix(mint, #6b7280, sonido.muted)
                    opacity: meter
                    box { at: l.x, ojo.y - 2.8 * alarma; size: z.w, z.h; corner: l.corner; blend: ojo.fusion }
                    box { at: r.x, ojo.y + 6.2 * alarma; size: z.rw2, z.rh2; corner: r.corner; blend: ojo.fusion }
                }
            }

            //  El diafragma. La gota no se desvanece: se le come el centro con una
            //  forma del color de la bolita, así que queda un anillo que crece hasta
            //  que ya no hay anillo. Un número blanco sobre una gota blanca que se
            //  funde sale gris y turbio; esto sale limpio, y además es la misma
            //  cuenta de siempre: aquí todo son distancias, y un agujero es una
            //  forma más.
            body {
                color: coal
                ellipse { at: x, ojo.y; radius: g.w / 2 * abre * 1.25 }
            }

            //  El hueco de la cámara. El cuerpo no se dibuja con un borde: se le
            //  come el centro con una forma del color de la bolita, que es como se
            //  hace un agujero cuando todo son distancias. Crece desde nada, así
            //  que el ojo se vacía en vez de cambiarse por un marco.
            body {
                color: coal
                box { at: x, ojo.y; size: 21.3 * cam, 14 * cam; corner: 3.3 }
            }

            //  Y el objetivo encima del hueco, que es lo único que el hueco se
            //  llevó por delante. Misma forma y mismo sitio que el ojo de debajo,
            //  así que no se ve ningún cruce: se ve un ojo que se vacía alrededor.
            body {
                color: ink
                opacity: cam
                ellipse { at: x, ojo.y; radius: ojo.l / 2 }
            }

            //  El visor. Este no puede ser un ojo —ya se usaron los dos— así que es
            //  una marca aparte, despegada del contorno para que no se junten en
            //  una costura, y entra y sale con el resto.
            box {
                at: x - 6.2, ojo.y - 11.6
                size: 5.7 * cam, 2.9 * cam
                corner: 1.2
                color: ink
            }

            //  El disco de grabar, justo encima del ojo izquierdo y de su tamaño:
            //  no es una forma que llega, es el ojo que se pone rojo. Y el rojo se
            //  enciende con `taping`, no con la pulsación: el disco dice que el
            //  grabador ESTÁ corriendo, no que se lo ha pedido.
            body {
                color: mix(#34373a, #fc6753, red)
                opacity: dot
                ellipse { at: l.x, ojo.y; radius: d.w / 2 }
            }

            //  El porcentaje del nivel, en la frente. Sube los tres últimos píxeles
            //  mientras aparece: entra con la barra en vez de encenderse encima.
            text number(sonido.volume * 100, 0, " %") {
                at: x, y - 9 + (1 - meter) * 3
                anchor: center
                size: 9
                weight: 600
                color: ink
                opacity: meter
            }

            //  El número de la cuenta, donde estaban sus ojos. Grande para leerse
            //  desde el otro lado de la mesa, que es toda la razón de que esté aquí
            //  y no en una etiqueta aparte: lo que va a empezar lo hace ella.
            group {
                pivot: x, ojo.y
                scale: 1 + pop, 1 + pop
                text number(max(left, 1), 0) {
                    at: x, ojo.y
                    anchor: center
                    size: 24.6
                    weight: 300
                    color: ink
                    //  Entra antes que el anillo se vaya del todo: para cuando el
                    //  agujero lo enseña, ya está ahí. Si entrara después, el
                    //  diafragma se abriría sobre nada.
                    opacity: clamp(abre * 1.7, 0, 1)
                }
            }
        }
    }

    //  Hundida en el borde, su centro cae casi sobre la superficie del agua, así
    //  que unos ojos centrados en él salen con la coronilla cortada por el borde
    //  de la pantalla: se veían dos rayitas. Bajarlos dentro de la cara los
    //  enseña enteros sin tener que enseñar más de ella. Son los 7 de 56 de
    //  Marea, por 46/56, y algo menos ahora que asoma más.
    Cara(cx, cy_real, gaze.x * (1 - atenta) + 4 * atenta, gaze.y * (1 - atenta), (1 - out) * 4.5 * if(hidden, 1, 0))

    // ── la cápsula del Remanso ───────────────────────────────────
    //  El conjunto —ella y la cápsula—, para la gracia al salir. Y va DEBAJO de
    //  lo que lleva dentro, como la del panel: la pulsación es de la zona de
    //  más arriba, y declarada al final se quedaba con el clic de «Terminar».
    //  Es la cuarta vez que pasa esto; ya no es un despiste, es una forma de la
    //  escena, y por eso está escrito aquí y no solo allí.
    zone box cap_conj { at: cx + 70, cy_real + 8; size: 260, 136; corner: 30; active: capsula > 0.01 }
    on away cap_conj for 300ms { note = false }

    //  Al pasar el cursor, lo que hace falta saber: en qué está, cuánto le
    //  queda, cuántos ha guardado, y cómo salir. Nada más: si hiciera falta
    //  abrir algo para enterarse, no serviría de nada.
    let cap.abre = clamp(capsula * 2.2 - 1.2, 0, 1)
    group {
        opacity: cap.abre
        move: (1 - cap.abre) * -8, 0
        arc { at: cap.x - 76, cap.y - 22; radius: 7.5; span: 210deg; width: 5; rotate: 145deg; color: #8fa2e8 }
        text "No molestar · {queda, 0} min" { at: cap.x - 60, cap.y - 26; anchor: left center; size: 12; weight: 500; color: ink }
        text "{pendientes, 0} avisos guardados" { at: cap.x - 60, cap.y - 9; anchor: left center; size: 10.5; color: #8b8f95 }
        prop term.luz = 0 ~140ms
        prop regl.luz = 0 ~140ms
        box { at: cap.x - 52, cap.y + 22; size: 96, 30; corner: 10; color: mix(#2a1b1b, #3a2424, term.luz) }
        box { at: cap.x - 84, cap.y + 22; size: 11, 11; corner: 3; color: #e0655a }
        text "Terminar" { at: cap.x - 44, cap.y + 22; anchor: center; size: 11.5; weight: 500; color: ink }
        box { at: cap.x + 52, cap.y + 22; size: 96, 30; corner: 10; color: mix(#1b1b1c, #232425, regl.luz) }
        text "Ver reglas" { at: cap.x + 52, cap.y + 22; anchor: center; size: 11.5; color: #8b8f95 }
        zone box terminar { at: cap.x - 52, cap.y + 22; size: 96, 30; corner: 10; cursor: pointer; active: capsula > 0.8 }
        zone box reglas { at: cap.x + 52, cap.y + 22; size: 96, 30; corner: 10; cursor: pointer; active: capsula > 0.8 }
        on enter terminar { term.luz: 1 }
        on leave terminar { term.luz: 0 }
        on enter reglas { regl.luz: 1 }
        on leave reglas { regl.luz: 0 }
        on press terminar { emit salir_remanso }
        on press reglas { emit ver_reglas }
    }
    //  Al volver, un único resumen. Las gotas normales siguen escondidas
    //  mientras está: soltar de golpe toda la cola sería lo contrario de lo que
    //  el Remanso vino a hacer.
    let res.abre = clamp(resumen * 2 - 1, 0, 1)
    group {
        opacity: res.abre
        move: (1 - res.abre) * -10, 0
        ellipse { at: res.x - 78, cy_real; radius: 8; color: azul }
        text "{pendientes, 0} novedades importantes" { at: res.x - 62, cy_real; anchor: left center; size: 11.5; color: ink }
        path { at: res.x + 86, cy_real - 5; color: #8b8f95; stroke: 1.6; move 0, 0; line 5, 5; line 0, 10 }
    }

    // ── la membrana del Remanso ──────────────────────────────────
    //  Todo esto vive DENTRO de su silueta: entrar en Remanso no la agranda.
    //  El agua se dibuja recortada a la bolita, así que la línea se corta
    //  donde acaba ella y no hace falta calcular dónde.
    let agua.y = cy_real + 7
    let agua.tilt = marea * 0.10
    group {
        clip inset 0 ellipse { at: cx, cy_real; radius: r }
        opacity: calma
        //  Lo que hay bajo la línea de agua: un poco más claro que ella, como
        //  el agua vista desde fuera.
        box { at: cx, agua.y + 22; size: 70, 44; color: #1d2b2c; rotate: agua.tilt }
        //  Y la línea, que es lo único que se mueve: la marea cambia de
        //  pendiente despacio, sin mover el cuerpo ni las perlas.
        box { at: cx, agua.y; size: 70, 1.4; color: #7fd6c4; rotate: agua.tilt; opacity: 75% }
        //  Las perlas: una por categoría, guardadas bajo el agua. Aparecen al
        //  guardarse la primera, engordan un poco con lo que se va guardando
        //  —hasta tres, y ahí se queda: una perla que crece sin freno es una
        //  cuenta, y la cuenta ya está en la cápsula— y laten cuando cae otra.
        //  Eso es todo lo que pasa aquí dentro, y pasa despacio.
        repeat k in 1..5 {
            let px = cx - 13.5 + (k - 1) * 9
            let perla.r = (2.8 + 0.6 * min(n.$k, 3)) * (1 + late.$k * 0.5)
            ellipse { at: px, agua.y + 9; radius: perla.r * perla.$k
                      color: mix(mix(mix(azul, lila, k > 1.5), verde, k > 2.5), ambar, k > 3.5)
                      opacity: perla.$k * 85% }
        }
    }
    //  La perla ámbar de una urgencia permitida: sobre la membrana, no debajo
    //  del agua. Lo que se guarda va abajo; lo que pasa, arriba.
    //  A las tres en punto de su membrana, lejos de la luna: juntas se leían
    //  como una sola cosa rara en el borde.
    ellipse { at: cx + 20, cy_real - 11.5; radius: 4.2; color: #e2b25a; opacity: mirada }

    //  La membrana, del mismo diámetro que ella. La dibuja una ola que la
    //  recorre una vez al entrar: el arco crece de nada a entera.
    arc { at: cx, cy_real; radius: r; span: 360deg * dibuja; width: 1.3; color: #7fd6c4; opacity: calma * 85% }

    //  La luna, en el cuadrante superior derecho y fuera de ella. Es un camino
    //  de dos curvas —el filo de fuera y el de dentro—, que es como se dibuja
    //  un cuarto creciente cuando no puedes restar una forma de otra.
    let luna.x = cx + 22
    let luna.y = cy_real - 31
    //  Un creciente es un arco gordo, así que eso es: 210° de 5,5 de grueso,
    //  girados para que abra hacia abajo y a la izquierda. Con dos curvas
    //  salía un gancho; esto es lo que la forma es de verdad.
    arc { at: luna.x, luna.y; radius: 7.5; span: 210deg; width: 5.5; rotate: 145deg; color: #8fa2e8; opacity: calma }



    // ── las gotas ────────────────────────────────────────────────
    //  Hasta cuatro, una por categoría y **la más reciente primero**, bajando
    //  por su lado derecho desde el hombro. Nada sobresale por encima de su
    //  cabeza: ahí arriba está el borde de la pantalla. El sitio de cada una
    //  es cuántas hay más recientes que ella, y viaja a él con un muelle POR
    //  EL ARCO —el ángulo es lo que se anima, no la x y la y—, así que cuando
    //  llega una nueva las demás se corren hombro abajo sin atajar por dentro
    //  de ella.
    repeat k in 1..5 {
        prop sitio.$k = 0 ~calm
        prop hay.$k = 0 ~240ms
        follow sitio.$k = if(n.1 > 0 and last.1 > last.$k, 1, 0) + if(n.2 > 0 and last.2 > last.$k, 1, 0) + if(n.3 > 0 and last.3 > last.$k, 1, 0) + if(n.4 > 0 and last.4 > last.$k, 1, 0)
        //  En Remanso las gotas del hombro se recogen: ahí abajo son perlas.
        follow hay.$k = if(n.$k > 0 and not open, 1, 0) * (1 - calma) * (1 - resumen)
        //  Del hombro al abanico **por el arco**: lo que se anima es el ángulo,
        //  así que las gotas bajan rodeándola y no atajando por dentro de ella.
        //  Todo el abanico gira 76° y se aleja 10: el sitio de cada una dentro
        //  de él sigue siendo el suyo.
        //  Abiertas se separan algo más —30° en vez de 26— para que no se
        //  toquen, y el abanico queda centrado bajo ella.
        let ang.$k = -24 + (26 + 4 * abanico) * sitio.$k + 69 * abanico
        let radio.$k = 31.7 + 10.3 * abanico
        let gx.$k = cx + radio.$k * cos(ang.$k)
        let gy.$k = cy_real + radio.$k * sin(ang.$k)
        let color.$k = mix(mix(mix(azul, lila, k > 1.5), verde, k > 2.5), ambar, k > 3.5)
        group {
            pivot: gx.$k, gy.$k
            scale: hay.$k * (1 + late.$k), hay.$k * (1 + late.$k)
            opacity: hay.$k
            ellipse { at: gx.$k, gy.$k; radius: 7 + 3 * abanico; color: color.$k }
            //  Recogida enseña su cuenta; abierta, el icono de su categoría.
            //  Lo que dice cambia porque lo que preguntas es otra cosa: recogida,
            //  cuántos hay; abierta, de quién.
            group {
                opacity: 1 - abanico
                text number(n.$k, 0) { at: gx.$k, gy.$k + 0.5; anchor: center; size: 8.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 1, 0) }
                text "9+" { at: gx.$k, gy.$k + 0.5; anchor: center; size: 7.5; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 0, 1) }
            }
            group {
                opacity: clamp(abanico * 2 - 1, 0, 1)
                //  Mensajes: un bocadillo. Trabajo: una cartera. Calendario: una
                //  hoja con sus anillas. Sistema: el engranaje de siempre.
                box { at: gx.$k, gy.$k - 1; size: 11, 8; corner: 2.5; color: #0a0c10; show: k == 1 }
                path { at: gx.$k - 3.5, gy.$k + 3; color: #0a0c10; show: k == 1
                       move 0, 0; line 4, 0; line 1, 3.5; close }
                box { at: gx.$k, gy.$k + 1; size: 11, 8; corner: 1.5; color: #0a0c10; show: k == 2 }
                box { at: gx.$k, gy.$k - 4; size: 5, 3; corner: 1; color: #0a0c10; show: k == 2 }
                box { at: gx.$k, gy.$k + 1; size: 10, 9; corner: 1.5; color: #0a0c10; show: k == 3 }
                box { at: gx.$k - 2.5, gy.$k - 5; size: 1.6, 3; corner: 0.8; color: #0a0c10; show: k == 3 }
                box { at: gx.$k + 2.5, gy.$k - 5; size: 1.6, 3; corner: 0.8; color: #0a0c10; show: k == 3 }
                arc { at: gx.$k, gy.$k; radius: 4.6; span: 300deg; width: 1.6; color: #0a0c10; show: k == 4 }
                ellipse { at: gx.$k, gy.$k; radius: 1.7; color: #0a0c10; show: k == 4 }
            }
        }
        //  Pulsar una gota abre el oleaje: es de las cuatro maneras que dice el
        //  contrato, y la más directa —ya estás mirando ahí—.
        zone box gotazona.$k { at: gx.$k, gy.$k; size: 24, 24; corner: 12; cursor: pointer; active: hay.$k > 0.5 and not bandeja and not open }
        on press gotazona.$k { cat = k; emit abrir_bandeja }
        //  La gota donde cae algo late una vez, y su número con ella. Nada en bucle.
        on landed while cual == k { n.$k = n.$k + cuantos; last.$k = max(last.$k, miseq); impulse late.$k 5 }
        on direct while cat == k { n.$k = n.$k + 1; last.$k = seq; impulse late.$k 5 }
    }

    // ── la vista previa ──────────────────────────────────────────
    //  Debajo del abanico, lo más reciente: quién y la primera línea. Es lo que
    //  contesta la pregunta sin abrir nada, que es para lo que se pasa por
    //  encima. Entra un poco después que las gotas, cuando ya están puestas.
    let vp.x = cx
    let vp.y = cy_real + 82
    let vp.abre = clamp(abanico * 2 - 1, 0, 1)
    body {
        color: #0c0f12
        rim: 4%
        shadow: 0, 6, 14, 30%
        opacity: vp.abre
        box { at: vp.x, vp.y; size: 250 * vp.abre, 46 * vp.abre; corner: 14 }
    }
    group {
        opacity: clamp(abanico * 3 - 2, 0, 1)
        move: 0, (1 - vp.abre) * 6
        box { at: vp.x - 116, vp.y; size: 3, 26; corner: 1.5; color: tinte }
        text who { at: vp.x - 106, vp.y - 8; anchor: left center; size: 11.5; weight: 600; width: 200; lines: 1; color: #f6f6f5 }
        text line { at: vp.x - 106, vp.y + 8; anchor: left center; size: 10.5; width: 200; lines: 1; color: #a9adb3 }
    }
    //  El conjunto —ella, el abanico y la vista previa— para la gracia al salir:
    //  el hueco entre las tres es real y no puede perderse al cruzarlo.
    zone box abanico_conj { at: cx, cy_real + 40; size: 260, 180; corner: 30; active: abanico > 0.01 }

    // ── el aviso que llega ───────────────────────────────────────
    //  Del centro de la tarjeta al hombro por dos curvas distintas: de lado a
    //  ritmo constante, y hacia arriba deprisa. El camino se dobla.
    //
    //  Y si llegan varias, se apilan: tres a la vista y «+N más». Vuelan
    //  juntas, cada una un poco después de la anterior, y el boing es UNO,
    //  lleguen las que lleguen. Una mascota que pega un bote por cada mensaje
    //  de un grupo es una mascota que se acaba apagando.
    let tinte = mix(mix(mix(azul, lila, cual > 1.5), verde, cual > 2.5), ambar, cual > 3.5)
    let av.x0 = cx + 23 + 14 + 125
    let av.dx = cx + 31.7 * cos(-24) - av.x0
    let av.dy = 31.7 * sin(-24)

    repeat j in 0..3 {
        //  `atras` es cuántas tiene encima: 0 es la de delante.
        let atras = 2 - j
        let vuelo = vuela.$j
        let aw = (250 - atras * 22) + (8.3 - 250 + atras * 22) * vuelo
        let ah = 44 + (8.3 - 44) * vuelo
        let ax = av.x0 + av.dx * vuelo + (1 - entra) * 30
        let ay = cy_real + av.dy * (1 - (1 - vuelo) * (1 - vuelo)) + atras * 8 * (1 - vuelo)
        body {
            //  Las de detrás no llevan su color hasta que vuelan: mientras
            //  esperan son papel apilado, y el color es de la que se lee.
            color: mix(mix(#0c0f12, #171b1f, atras > 0), tinte, vuelo)
            opacity: entra
            shadow: 0, 6, 14, 30%
            show: cuantos > atras
            box { at: ax, ay; size: aw, ah; corner: min(ah / 2, 14 + (ah / 2 - 14) * vuelo) }
        }
        group {
            show: atras == 0
            opacity: entra * (1 - clamp(vuelo * 5, 0, 1))
            box { at: ax - 120, ay; size: 3, 28; corner: 1.5; color: tinte }
            text who { at: ax - 110, ay - 8; anchor: left center; size: 11.5; weight: 600; color: #f6f6f5 }
            text line { at: ax - 110, ay + 8; anchor: left center; size: 10.5; width: 190; lines: 1; color: #a9adb3 }
            text "ahora" { at: ax + 113, ay - 8; anchor: right center; size: 9.5; color: #8b8f95 }
        }
    }
    //  Y las que no caben, dichas y no dibujadas: «+N más» debajo del montón.
    text "+{cuantos - 3, 0} más" {
        at: av.x0 + 113, cy_real + 40
        anchor: right center
        size: 9.5
        weight: 600
        color: #8b8f95
        opacity: entra * (1 - clamp(vuela.2 * 5, 0, 1))
        show: cuantos > 3
    }


    // ── la bandeja: el oleaje ────────────────────────────────────
    //  Su sitio y su tamaño. La forma la pone su cuerpo, más arriba; aquí van
    //  las medidas y lo que lleva escrito.
    let tray.w = 520 * tray
    let tray.h = 460 * tray
    //  Pegada a ella, no al lado: se solapan 17 px, y con eso el fundido hace
    //  un cuello de verdad. Con el hueco de 40 que lleva la otra tarjeta no
    //  había nada que fundir y se quedaban en dos cosas juntas.
    let tray.x = cx + 6 + tray.w / 2
    let tray.y = cy_real + tray.h / 2 - 8

    //  La zona de gracia va DEBAJO de las filas: la pulsación es de la zona de
    //  más arriba, y declarada al final se quedaba con el clic de cada fila.
    //  Se cierra al salir del conjunto —ella y la bandeja—, con los mismos
    //  320 ms que la nota: el hueco entre las dos es real.
    zone box bandeja_conj { at: cx + tray.w / 2, cy_real + tray.h / 2 - 8; size: 2 * r + 40 + tray.w, 2 * r + 40 + tray.h; corner: 30; active: bandeja }
    on away bandeja_conj for 320ms { emit cerrar_bandeja }

    group {
        opacity: clamp(tray * 2.6 - 1.6, 0, 1)
        let tx0 = tray.x - 232
        let ty0 = tray.y - 198

        text "OLEAJE" { at: tx0, ty0; anchor: left center; size: 9.5; weight: 600; color: ink; opacity: 35% }
        text "Ahora" { at: tx0, ty0 + 24; anchor: left center; size: 19; weight: 500; color: ink }

        //  El carril: las gotas se van de su hombro a la cabecera de la
        //  bandeja, y ahí se quedan como pastillas con su cuenta. El viaje es
        //  por el arco —lo que se anima es el ángulo—, así que salen rodeándola
        //  y no atajando por dentro.
        repeat k in 1..5 {
            let ang = -24 + 26 * sitio.$k
            let gx = cx + 31.7 * cos(ang)
            let gy = cy_real + 31.7 * sin(ang)
            let rx = tray.x + 78 + (k - 1) * 40
            let ry = ty0 + 14
            let px = gx + (rx - gx) * carril
            let py = gy + (ry - gy) * (1 - (1 - carril) * (1 - carril))
            group {
                opacity: hay.$k
                ellipse { at: px, py; radius: 7 + 4 * carril; color: mix(mix(mix(azul, lila, k > 1.5), verde, k > 2.5), ambar, k > 3.5) }
                text number(n.$k, 0) { at: px, py + 0.5; anchor: center; size: 8.5 + 2 * carril; weight: 700; color: #0a0c10; opacity: if(n.$k < 10, 1, 0) }
            }
        }

        //  Las filas. Cada una llega un poco después que la de arriba: eso es
        //  el oleaje, y por eso no entran todas de golpe como una lista.
        repeat k in 1..6 {
            let fy = ty0 + 76 + hueco.$k * 66 + (1 - sube.$k) * 26
            //  Donde descansa, y donde está ahora. Lo que se descubre va en el
            //  sitio de descanso —el hueco que deja— y no siguiéndola, o quedaría
            //  debajo de ella y no se vería nunca.
            let fx0 = tx0 + 232
            let fx = fx0 + fuera.$k * 520 + tira.$k
            //  El ámbar de un urgente pisa al color de su categoría: lo que
            //  importa de esa fila ya no es de quién es, es que corre prisa.
            let color.$k = mix(mix(mix(mix(azul, lila, k > 1.5), verde, k > 2.5), ambar, k > 3.5), #e2b25a, if(urg.$k, 1, 0))
            group {
                opacity: sube.$k * (1 - fuera.$k)
                show: viva.$k
                //  Lo que descubre al deslizarla, a un lado y al otro: hacia la
                //  derecha, «Hecho»; hacia la izquierda, «Descartar». Y son dos
                //  cosas distintas: lo hecho manda su gota de vuelta, **lo
                //  descartado no**, porque lo descartado no vuelve.
                group {
                    opacity: clamp((tira.$k + fuera.$k * 520) / 40, 0, 1)
                    box { at: fx0 - 160, fy; size: 130, 58; corner: 14; color: #1b2a22 }
                    text "Hecho" { at: fx0 - 160, fy; anchor: center; size: 12; weight: 600; color: mint }
                }
                group {
                    opacity: clamp((0 - tira.$k - fuera.$k * 520) / 40, 0, 1)
                    box { at: fx0 + 160, fy; size: 130, 58; corner: 14; color: #2a1b1b }
                    text "Descartar" { at: fx0 + 160, fy; anchor: center; size: 12; weight: 600; color: #e0655a }
                }
                box { at: fx, fy; size: 456, 58; corner: 14; color: mix(mix(#171717, #1d1d1e, toca.$k), #241f16, if(urg.$k, 1, 0)) }
                //  La barra de su categoría, a la izquierda: es de donde saldrá
                //  la gota cuando se resuelva.
                box { at: fx - 214, fy; size: 4, if(urg.$k, 46, 34); corner: 2; color: color.$k }
                text fila.$k.app { at: fx - 200, fy - 18; anchor: left center; size: 8.5; weight: 700; color: color.$k }
                text fila.$k.que { at: fx - 200, fy - 1; anchor: left center; size: 12.5; weight: 500; width: 300; lines: 1; color: ink }
                text fila.$k.mas { at: fx - 200, fy + 17; anchor: left center; size: 10.5; width: 300; lines: 1; color: #8b8f95 }
                text fila.$k.hora { at: fx + 208, fy - 18; anchor: right center; size: 9.5; color: #8b8f95 }
            }
            zone box filazona.$k { at: fx, fy; size: 456, 58; corner: 14; cursor: pointer; active: tray > 0.9 and viva.$k }
            on enter filazona.$k { toca.$k: 1 }
            on leave filazona.$k { toca.$k: 0 }
            on press filazona.$k { emit resolver(k) }

            //  Y la gota que vuelve. Nace PEGADA a la barra de color de su fila
            //  —fundida con ella— y se despega al salir: el pellizco no se
            //  dibuja, sale de las distancias, como el del borde del agua.
            let vx = fx - 214 + (cx + 31.7 * cos(-24) - fx + 214) * suelta.$k
            let vy = fy + (cy_real + 31.7 * sin(-24) - fy) * (1 - (1 - suelta.$k) * (1 - suelta.$k))
            body {
                color: color.$k
                opacity: clamp(suelta.$k * 8, 0, 1) * (1 - clamp(suelta.$k * 8 - 7, 0, 1))
                box { at: fx - 214, fy; size: 4, 34 * (1 - suelta.$k); corner: 2; blend: 14 * 4 * suelta.$k * (1 - suelta.$k) }
                ellipse { at: vx, vy; radius: 4 + 3 * suelta.$k; blend: 14 * 4 * suelta.$k * (1 - suelta.$k) }
            }
        }

        //  El pie: lo que ha llegado, y sus ajustes. Mientras se puede deshacer
        //  su sitio es de la mecha, que es más urgente que un enlace.
        group {
            show: not deshacer
            text "Historial" { at: tx0, tray.y + 198; anchor: left center; size: 11.5; color: #8b8f95 }
            text "Ajustes" { at: tray.x + 232, tray.y + 198; anchor: right center; size: 11.5; color: #8b8f95 }
        }

        // ── deshacer, con su mecha ───────────────────────────────
        //  Cinco segundos, y se ve cuántos quedan: la mecha se consume de
        //  izquierda a derecha a ritmo constante. Que se vea el tiempo irse es
        //  lo que hace que no haya que leer «5 s» en ninguna parte.
        group {
            show: deshacer
            let dz.y = tray.y + 198
            prop dz.luz = 0 ~140ms
            box { at: tray.x, dz.y; size: 456, 40; corner: 12; color: mix(#1b1b1c, #232425, dz.luz) }
            //  La mecha, pegada al borde de abajo de su pastilla.
            box { from: tray.x - 228, dz.y + 16; size: 456 * mecha, 4; corner: 2; color: mint }
            text "Hecho. ¿Lo deshago?" { at: tray.x - 208, dz.y - 3; anchor: left center; size: 11.5; color: #8b8f95 }
            text "Deshacer" { at: tray.x + 192, dz.y - 3; anchor: right center; size: 12; weight: 600; color: mint }
            zone box deshacer_zona { at: tray.x, dz.y; size: 456, 40; corner: 12; cursor: pointer; active: deshacer }
            on enter deshacer_zona { dz.luz: 1 }
            on leave deshacer_zona { dz.luz: 0 }
        }
    }

    //  La zona de gracia del panel va DEBAJO de lo que lleva dentro: la
    //  pulsación es de la zona de más arriba, y declarada al final se
    //  quedaba con TODOS los clics de la tarjeta. Es la tercera vez.
    //  Se cierra al salir del conjunto, con 320 ms de gracia para un desvío.
    zone box conjunto { at: cx + card * 300, cy_real + card.h / 2 - 8; size: 200 + card.w + 80, 2 * r + 30 + card.h; corner: 30; active: open }
    on away conjunto for 320ms { open = false }

    // ── la tarjeta ───────────────────────────────────────────────
    //  El centro de control, medido sobre la lámina
    //  (`design/concepts/2026-08-31-centro-y-apps/centro-de-control.png`): la
    //  bolita mide 70 ahí y 46 aquí, así que todo va por 46/70.
    //
    //  Tres tarjetas, no seis: Wi-Fi, Bluetooth y Concentración. Y los dos
    //  niveles son **brillo y volumen**, con su icono DEBAJO de la pista, el
    //  rótulo y el tanto por ciento en menta. Lo de las seis y la órbita es del
    //  ControlCenter de ahora, que ya no es esta lámina.
    let card.w = 390 * card
    let card.h = 410 * card
    //  Pegada a ella, no al lado: se solapan 17 px y con eso el fundido hace un
    //  cuello. Es lo mismo que la bandeja, y por la misma razón: la tarjeta no
    //  aparece al lado, sale de ella.
    let card.x = cx + 6 + card.w / 2
    let card.y = cy_real + card.h / 2 - 8


    clip inset 2 box { at: card.x, card.y; size: card.w, card.h; corner: 22 * card }
    group {
        opacity: content
        move: 0, (1 - content) * 10

        let x0 = card.x - 178
        //  Lo de la portada se va mientras la página crece: no hay dos cosas a
        //  medias, y lo que queda debajo se ve por el hueco de la que sube.
        let portada = 1 - clamp(pag * 1.6, 0, 1)
        let y0 = card.y - 182

        text "MAREA" { at: x0, y0; anchor: left center; size: 9; weight: 600; color: ink; opacity: 38% }
        text "Centro de control" { at: x0, y0 + 22; anchor: left center; size: 18; weight: 500; color: ink }
        //  El engranaje y la cruz, arriba a la derecha.
        prop eng.luz = 0 ~140ms
        prop cruz.luz = 0 ~140ms
        let eng.x = card.x + 118
        let cruz.x = card.x + 154
        group {
            opacity: 55% + eng.luz * 45%
            arc { at: eng.x, y0 + 14; radius: 7; span: 300deg; width: 1.8; color: ink }
            ellipse { at: eng.x, y0 + 14; radius: 2.6; color: ink }
        }
        group {
            opacity: 55% + cruz.luz * 45%
            line { from: cruz.x - 6, y0 + 8; to: cruz.x + 6, y0 + 20; width: 1.8; color: ink }
            line { from: cruz.x + 6, y0 + 8; to: cruz.x - 6, y0 + 20; width: 1.8; color: ink }
        }
        zone box engranaje { at: eng.x, y0 + 14; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 }
        zone box cerrar { at: cruz.x, y0 + 14; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 }
        on enter engranaje { eng.luz: 1 }
        on leave engranaje { eng.luz: 0 }
        on enter cerrar { cruz.luz: 1 }
        on leave cerrar { cruz.luz: 0 }
        on press engranaje { emit ajustes }
        on press cerrar { open = false }

        group {
            opacity: portada
            // ── los dos niveles ──────────────────────────────────────
            //  Arrastrarlos los mueve de verdad: la escena dice a dónde va el dedo
            //  y la lógica se lo pide al sistema. Aquí no se inventa el valor —lo
            //  sigue leyendo el servicio—, así que subir el volumen con la tecla
            //  mueve esta misma pista.
            //  Todo lo de abajo, medido sobre la lámina y escrito desde el centro
            //  de la tarjeta: la cabecera acaba en −150 y el contenido empieza en
            //  −134. Antes la columna de la derecha empezaba en −165 y se le subía
            //  encima a la cruz.
            let niv.x = card.x - 93
            let niv.y = card.y - 15
            box { at: niv.x, niv.y; size: 170, 238; corner: 16; color: #1b1b1c }
            repeat k in 0..2 {
                let sx = niv.x - 38 + k * 76
                let val = if(k == 0, brillo, nivel)
                let mudo = if(k == 0, 0, if(sonido.muted, 1, 0))
                let hay = if(k == 0, if(pantalla.present, 1, 0), 1)
                let arriba = niv.y - 110
                let alto = 150
                group {
                    opacity: 25% + hay * 75%
                    //  La pista, y lo lleno desde abajo.
                    box { at: sx, arriba + alto / 2; size: 14, alto; corner: 7; color: #2a2b2c }
                    box { from: sx - 7, arriba + alto * (1 - val); size: 14, alto * val; corner: 7
                          color: mix(mint, #6b7280, mudo) }
                    //  Y el tirador, que es lo que dice dónde estás.
                    ellipse { at: sx, arriba + alto * (1 - val); radius: 9; color: #f0ece4 }
                }
                //  El icono va DEBAJO, y con él el rótulo y el tanto por ciento.
                let iy = niv.y + 62
                group {
                    opacity: (25% + hay * 75%) * (1 - mudo * 0.45)
                    //  El sol del brillo: un disco y ocho rayos.
                    ellipse { at: sx, iy; radius: 4.5; color: ink; show: k == 0 }
                    repeat r in 0..8 {
                        line { from: sx + 7.5 * cos(r * 45), iy + 7.5 * sin(r * 45)
                               to: sx + 10.5 * cos(r * 45), iy + 10.5 * sin(r * 45)
                               width: 1.6; color: ink; show: k == 0 }
                    }
                    //  El altavoz del volumen: cuerpo, bocina y dos ondas.
                    path { at: sx - 8, iy - 5; color: ink; show: k == 1
                           move 0, 3; line 4, 3; line 9, 0; line 9, 11; line 4, 8; line 0, 8; close }
                    arc { at: sx + 3, iy; radius: 6; span: 110deg; width: 1.5; rotate: 90deg; color: ink; show: k == 1 }
                    arc { at: sx + 3, iy; radius: 9.5; span: 110deg; width: 1.5; rotate: 90deg; color: ink; show: k == 1 }
                }
                line { from: sx - 9, iy - 9; to: sx + 9, iy + 9; width: 1.8; color: #e0655a; opacity: mudo }
                text "Brillo" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 0 }
                text "Volumen" { at: sx, iy + 24; anchor: center; size: 11.5; color: ink; show: k == 1 }
                text "{val * 100, 0}%" { at: sx, iy + 42; anchor: center; size: 11.5; weight: 500; color: mint }
                //  Arrastrar la pista, y pulsar el icono para silenciar.
                zone box pista.$k { at: sx, arriba + alto / 2; size: 34, alto + 18; corner: 17; cursor: pointer; active: content > 0.9 }
                zone box icono.$k { at: sx, iy; size: 30, 30; corner: 15; cursor: pointer; active: content > 0.9 }

            }
            //  La pista: donde sueltes el dedo, ahí va. Con `pointer.y`, que es
            //  sobre la superficie, o sea las mismas coordenadas con las que está
            //  dibujada la pista: así la cuenta se lee al lado del dibujo.
            let dedo.0 = 1 - clamp((pointer.y - (card.y - 140)) / 150, 0, 1)
            on drag pista.0 { emit mover_brillo(dedo.0) }
            on press pista.0 { emit mover_brillo(dedo.0) }
            on drag pista.1 { emit mover_volumen(dedo.0) }
            on press pista.1 { emit mover_volumen(dedo.0) }
            on press icono.1 { emit mute_salida }

            // ── las tres de la lámina ────────────────────────────────
            //  Cada tarjeta es una `row` de tres: el icono, lo que se lee, y el
            //  interruptor o la flecha. Lo del medio pide el sitio que sobra
            //  (`grow: 1`) y sus textos lo cogen de ancho, así que **aquí no hay un
            //  solo ancho escrito a mano** y lo que no cabe se corta solo. Antes lo
            //  ponía yo y por eso el nombre de la red se metía bajo el interruptor.
            text titulo.1 = "Wi-Fi"
            text titulo.2 = "Bluetooth"
            text titulo.3 = "Concentración"
            text sub.1 = ""
            text sub.2 = "Auriculares"
            text sub.3 = "25 min"
            //  Los muelles y las zonas van FUERA del reparto: dentro de una `column`
            //  todo lo que hay es un hijo, y un `prop` no ocupa sitio.
            repeat k in 1..4 {
                prop luz.$k = 0 ~140ms
                zone box fila.$k { at: card.x + 90, card.y - 96 + (k - 1) * 74; size: 173, 66; corner: 14; cursor: pointer; active: content > 0.9 }
                //  El interruptor tiene su propia zona, ENCIMA de la de la
                //  tarjeta: pulsarlo enciende o apaga, y pulsar el resto abre la
                //  página. Antes el cuerpo se llevaba las dos cosas y el
                //  interruptor no hacía nada, así que con la Wi-Fi apagada no
                //  había manera de volver a ponerla desde aquí.
                zone box interruptor.$k { at: card.x + 146, card.y - 96 + (k - 1) * 74; size: 52, 44; corner: 20; cursor: pointer; active: content > 0.9 and k < 3 }
                on enter fila.$k { luz.$k: 1 }
                on leave fila.$k { luz.$k: 0 }
                on press interruptor.$k { emit conmutar(k) }
                //  Pulsar la tarjeta abre su página. El interruptor de Wi-Fi y
            //  Bluetooth sigue siendo del sistema; lo que aquí se abre es la lista.
                on press fila.$k { emit mirar(k) }
            }
            column tarjetas {
                at: card.x + 4, card.y - 129
                gap: 8
                repeat k in 1..4 {
                    row tarjeta {
                        size: 173, 66
                        gap: 6
                        padding: 8
                        //  Centrados a lo alto. Por defecto un reparto alinea a
                        //  `start`, y con eso el interruptor se quedaba pegado
                        //  arriba mientras el texto caía al medio.
                        align: center
                        //  La de Concentración va resaltada cuando está puesta: el
                        //  fondo un punto más verde. Es el único borde del panel, y
                        //  lo pinta la tarjeta, no el reparto.
                        fill: mix(mix(#1b1b1c, #202021, luz.$k), #1a241f, encendida.$k * if(k == 3, 1, 0))
                        corner: 14
                        group {
                            size: 20, 22
                            //  Wi-Fi: tres arcos y el punto.
                            repeat a in 1..4 {
                                //  Un arco se dibuja por ENCIMA de su punto, así
                                //  que el punto va abajo del todo: el icono ocupa
                                //  de y−16 a y+2, y se centra 7 más abajo.
                                arc { at: 10, 18; radius: 3 + a * 3.4; span: 110deg; width: 1.8; color: ink
                                      opacity: 40% + encendida.1 * 60%; show: k == 1 }
                            }
                            ellipse { at: 10, 19; radius: 1.8; color: ink; opacity: 40% + encendida.1 * 60%; show: k == 1 }
                            //  Bluetooth: la runa, de un trazo.
                            path { at: 6, 2; color: ink; stroke: 1.8; opacity: 40% + encendida.2 * 60%; show: k == 2
                                   move 0, 4; line 10, 14; line 5, 18; line 5, 0; line 10, 4; line 0, 14 }
                            //  Concentración: la luna, que es un disco al que otro
                            //  del color de la tarjeta le come un lado.
                            ellipse { at: 11, 11; radius: 9; color: ink; opacity: 70%; show: k == 3 }
                            ellipse { at: 16, 6; radius: 8.5; show: k == 3
                                      color: mix(mix(#1b1b1c, #202021, luz.$k), #1a241f, encendida.$k) }
                        }
                        //  Lo que se lee, con el sitio que quede. Sin anchos.
                        column { grow: 1; gap: 2
                            text titulo.$k { size: 13; lines: 1; color: ink }
                            text sub.$k { size: 11.5; lines: 1; color: #8b8f95; show: k == 2 }
                            text red.name { size: 11.5; lines: 1; color: #8b8f95; show: k == 1 }
                            //  La de Concentración cuenta lo que le queda, no lo
                            //  que duraría: puesta, lo que hace falta saber es
                            //  cuándo vuelve.
                            text "Puesto · {queda, 0} min" { size: 11.5; lines: 1; color: mint; show: k == 3 and remanso }
                            text sub.3 { size: 11.5; lines: 1; color: #8b8f95; show: k == 3 and not remanso }
                        }
                        //  El interruptor, o la flecha de las que abren una página.
                        //  La que abre una página solo lleva flecha, así que ocupa
                        //  mucho menos y a su texto le queda más sitio.
                        group {
                            size: if(k < 3, 40, 12), 23
                            box { from: 0, 0; size: 40, 23; corner: 11.5; color: mix(#2a2b2c, mint, encendida.$k); show: k < 3 }
                            ellipse { at: 11.5 + 18 * encendida.$k, 11.5; radius: 8.5; color: #ffffff; show: k < 3 }
                            path { at: 3, 6; color: ink; stroke: 1.6; opacity: 70%; show: k == 3
                                   move 0, 0; line 5, 5; line 0, 10 }
                        }
                    }
                }
            }
            //  El filo de menta de la que está puesta. Va aparte y con `stroke`
            //  —solo el contorno— porque el fondo de una maquetación es un color y
            //  no lleva borde; un `body` relleno encima tapaba la tarjeta entera.
            box { at: card.x + 90, card.y + 52; size: 173, 66; corner: 14
                  stroke: 1; color: mint; opacity: encendida.3 }


        }

        // ── la página, que sale de su tarjeta ────────────────────
        //  Crece desde el sitio de la tarjeta que se pulsó hasta llenar el
        //  panel. Lo de debajo se va mientras tanto: no hay dos cosas a medias.
        let pg.k = if(pagina == bluetooth, 2, 0) + if(pagina == concentracion, 3, 0) + if(pagina == wifi, 1, 0)
        let pg.ox = card.x + 90
        let pg.oy = card.y - 96 + (pg.k - 1) * 74
        let pg.x = pg.ox + (card.x - pg.ox) * pag
        let pg.y = pg.oy + (card.y + 26 - pg.oy) * pag
        let pg.w = 173 + 183 * pag
        let pg.h = 66 + 254 * pag
        box { at: pg.x, pg.y; size: pg.w, pg.h; corner: 14; color: #1b1b1c; opacity: pag }

        group {
            opacity: clamp(pag * 3 - 2, 0, 1)
            let px0 = card.x - 150
            //  La cabecera de la página: hacia atrás, y de qué va.
            path { at: card.x - 170, card.y - 122; color: ink; stroke: 1.8; opacity: 70%
                   move 5, 0; line 0, 5; line 5, 10 }
            text "Wi-Fi" { at: px0, card.y - 117; anchor: left center; size: 14; weight: 500; color: ink; show: pagina == wifi }
            text "Bluetooth" { at: px0, card.y - 117; anchor: left center; size: 14; weight: 500; color: ink; show: pagina == bluetooth }
            text "Concentración" { at: px0, card.y - 117; anchor: left center; size: 14; weight: 500; color: ink; show: pagina == concentracion }
            zone box atras { at: card.x - 166, card.y - 117; size: 34, 34; corner: 17; cursor: pointer; active: pag > 0.9 }
            on press atras { pagina = ninguna }

            //  Las redes que hay. Las trae la lógica de `nmcli`, porque pleamar
            //  sabe leer la red pero no listarla ni cambiarla.
            column lista_redes {
                at: card.x - 170, card.y - 96
                gap: 4
                show: pagina == wifi
                for r in redes {
                    group {
                        size: 340, 38
                        box { from: 0, 0; size: 340, 38; corner: 10; color: mix(#202021, #1a241f, r.puesta) }
                        //  La fuerza, con los mismos arcos de la tarjeta: cuantos
                        //  más encendidos, mejor llega.
                        repeat a in 1..4 {
                            arc { at: 20, 26; radius: 3 + a * 3.2; span: 110deg; width: 1.7; color: ink
                                  opacity: 20% + 80% * if(r.senal > (a - 1) * 0.25, 1, 0) }
                        }
                        ellipse { at: 20, 27; radius: 1.7; color: ink }
                        text r.nombre { at: 42, 19; anchor: left center; size: 12; width: 240; lines: 1; color: ink }
                        ellipse { at: 322, 19; radius: 4; color: mint; opacity: if(r.puesta, 100%, 0%) }
                        zone box tocarla { from: 0, 0; size: 340, 38; corner: 10; cursor: pointer }
                        on press tocarla { emit elegir_red(r.index) }
                    }
                }
            }
            text "Buscando redes…" { at: card.x, card.y + 20; anchor: center; size: 11.5; color: #8b8f95
                                     show: pagina == wifi and redes.count < 1 }

            //  Y los auriculares y demás, de `bluetoothctl`.
            column lista_bt {
                at: card.x - 170, card.y - 96
                gap: 4
                show: pagina == bluetooth
                for c in cacharros {
                    group {
                        size: 340, 38
                        box { from: 0, 0; size: 340, 38; corner: 10; color: mix(#202021, #1a241f, c.puesta) }
                        path { at: 15, 11; color: ink; stroke: 1.7; opacity: 80%
                               move 0, 4; line 10, 14; line 5, 18; line 5, 0; line 10, 4; line 0, 14 }
                        text c.nombre { at: 42, 19; anchor: left center; size: 12; width: 240; lines: 1; color: ink }
                        ellipse { at: 322, 19; radius: 4; color: mint; opacity: if(c.puesta, 100%, 0%) }
                        zone box tocarlo { from: 0, 0; size: 340, 38; corner: 10; cursor: pointer }
                        on press tocarlo { emit elegir_cacharro(c.index) }
                    }
                }
            }
            text "Nada emparejado" { at: card.x, card.y + 20; anchor: center; size: 11.5; color: #8b8f95
                                     show: pagina == bluetooth and cacharros.count < 1 }

            //  Concentración: lo que hace, dicho. No hay lista que traer.
            group {
                show: pagina == concentracion
                text "Mientras dure, los avisos se guardan y no se enseñan." {
                    at: card.x - 170, card.y - 86; anchor: left center; size: 12; width: 340; lines: 2; color: #8b8f95 }
                repeat m in 0..3 {
                    let mx = card.x - 116 + m * 116
                    prop mluz.$m = 0 ~140ms
                    box { at: mx, card.y - 20; size: 108, 44; corner: 12; color: mix(#202021, #262728, mluz.$m) }
                    text "{25 + m * 20} min" { at: mx, card.y - 20; anchor: center; size: 12.5; color: ink }
                    zone box mzona.$m { at: mx, card.y - 20; size: 108, 44; corner: 12; cursor: pointer; active: pagina == concentracion and pag > 0.9 }
                    on enter mzona.$m { mluz.$m: 1 }
                    on leave mzona.$m { mluz.$m: 0 }
                    //  Y aquí se entra en el Remanso: eliges cuánto, y lo
                    //  primero que hace es cerrarse. Quedarse abierto el panel
                    //  encima de ella sería lo contrario de lo que acabas de
                    //  pedir. La página se recoge antes para que al volver a
                    //  abrirlo estén las tres tarjetas y no el interior de una.
                    on press mzona.$m { queda = 25 + m * 20; pagina = ninguna; open = false; emit entrar_remanso }
                }
            }
        }

        group {
            opacity: portada
            // ── la línea y lo que suena ──────────────────────────────
            line { from: x0, card.y + 121; to: card.x + 178, card.y + 121; width: 1; color: ink; opacity: 12% }
            let by = card.y + 161
            group {
                show: medios.playing
                //  La portada, que aquí es un degradado: no hay carátula todavía.
                body {
                    gradient: radial x0 + 28, by - 6 radius 44, #e8c9a8, #6f8f7d
                    box { at: x0 + 28, by; size: 56, 56; corner: 12 }
                }
                text medios.title { at: x0 + 66, by - 9; anchor: left center; size: 12.5; width: 130; lines: 1; color: ink }
                text medios.artist { at: x0 + 66, by + 10; anchor: left center; size: 11; width: 130; lines: 1; color: #8b8f95 }
                //  Anterior, pausa y siguiente. La pausa va en su disco lleno.
                let bx1 = card.x + 76
                let bx3 = card.x + 156
                path { at: bx1 - 6, by - 7; color: ink; move 12, 0; line 12, 14; line 0, 7; close }
                box { at: bx1 - 8, by; size: 2.6, 14; corner: 1.3; color: ink }
                ellipse { at: card.x + 116, by; radius: 19; color: #2a2b2c }
                box { at: card.x + 112, by; size: 3.4, 14; corner: 1.7; color: ink }
                box { at: card.x + 120, by; size: 3.4, 14; corner: 1.7; color: ink }
                path { at: bx3 - 6, by - 7; color: ink; move 0, 0; line 12, 7; line 0, 14; close }
                box { at: bx3 + 10, by; size: 2.6, 14; corner: 1.3; color: ink }
                zone box antes { at: bx1, by; size: 34, 34; corner: 17; cursor: pointer; active: content > 0.9 }
                zone box tocar { at: card.x + 116, by; size: 42, 42; corner: 21; cursor: pointer; active: content > 0.9 }
                zone box luego { at: bx3, by; size: 34, 34; corner: 17; cursor: pointer; active: content > 0.9 }
                on press antes { emit anterior }
                on press tocar { emit tocar_pausa }
                on press luego { emit siguiente }
            }
            text "No suena nada" { at: card.x, by; anchor: center; size: 11.5; color: #8b8f95; show: not medios.playing }
        }

    }


    // ── abrir y cerrar ───────────────────────────────────────────
    //  Al abrir manda la geometría y el contenido entra detrás. Al cerrar, al
    //  revés: 50 ms de fundido y luego 210 de recogida, que es lo que hace que
    //  parezca que se la traga y no que se apaga.
    on change open while open {
        card: 1 ~290ms
        content: 1 ~200ms after 90ms
    }
    on change open while not open {
        content: 0 ~50ms
        card: 0 ~210ms after 50ms
    }

    // ── el nivel ─────────────────────────────────────────────────
    //  Se dispara con lo que cambie el volumen, venga de donde venga. Y no
    //  ocurre hundida: la tecla del volumen no va dirigida a ella.
    follow nivel = sonido.volume
    on change sonido.volume while out > 0.9 { meter: 1 }
    //  Aguanta 1,1 s tras el ÚLTIMO cambio, no tras cada uno: una ráfaga de
    //  teclazos es una lectura continua y no un parpadeo por escalón. Esto es
    //  lo que pleamar no sabía decir y ahora dice: `on still`.
    on still sonido.volume for 1.1s { meter: 0 }

    // ── la vida de un aviso ──────────────────────────────────────
    //  Un aviso la saca si está hundida, y entonces la tarjeta espera a que
    //  haya salido: separarse y presentar a la vez enterraba lo uno en lo otro.
    //  En Remanso se guarda y ya: ni tarjeta, ni salto, ni apertura. Solo
    //  crece su perla bajo la línea de agua.
    on notice while remanso { seq = seq + 1; emit direct }
    on notice while not remanso and fase == 0 and out > 0.9 { cual = cat; fase = 1; cuantos = 1; seq = seq + 1; miseq = seq; marca = marca + 1; needed = true; wanted = true; play startle; entra: 1 ~220ms }
    on notice while not remanso and fase == 0 and out <= 0.9 { cual = cat; fase = 1; cuantos = 1; seq = seq + 1; miseq = seq; needed = true; wanted = true; play startle; entra: 1 ~220ms after 560ms }
    on change out > 0.9 while fase == 1 { marca = marca + 1 }
    //  Otro mientras aún se está leyendo: se apila, y la lectura vuelve a
    //  empezar. Ni un bote más: el gesto ya está puesto, y una mascota que pega
    //  un bote por cada mensaje de un grupo se acaba apagando.
    on notice while not remanso and fase == 1 { seq = seq + 1; cuantos = cuantos + 1; marca = marca + 1 }
    //  Con la ráfaga ya volando, el que llega va derecho a su gota.
    on notice while not remanso and fase == 2 { seq = seq + 1; emit direct }

    //  3,2 s para leerla, que el puntero encima detiene: al irse, vuelve a
    //  contar. Es `on still` otra vez: «cuando lleve ese rato sin que nada
    //  vuelva a empezar la lectura».
    zone box aviso_zona { at: av.x0, cy_real + 7; size: 250, 58; corner: 14; cursor: pointer; active: fase == 1 }
    on enter aviso_zona { sobre = true }
    on leave aviso_zona { sobre = false; marca = marca + 1 }
    //  Y la propia tarjeta que llega: pulsarla abre el oleaje.
    on press aviso_zona { emit tray; emit abrir_bandeja }
    //  3,2 s para leer una; 4,2 si son varias, que es lo que dice el contrato.
    //  Son dos reglas porque el `for` de una regla es un tiempo escrito y no una
    //  cuenta; aquí no estorba, y dicho dos veces se lee bien.
    on still marca for 3.2s while fase == 1 and not sobre and cuantos < 2 { fase = 2 }
    on still marca for 4.2s while fase == 1 and not sobre and cuantos > 1 { fase = 2 }
    //  Y vuelan juntas, cada una un poco después de la anterior.
    on change fase while fase == 2 {
        vuela.2: 1 ~280ms
        vuela.1: 1 ~280ms after 45ms
        vuela.0: 1 ~280ms after 90ms
    }
    on change vuela.0 > 0.97 while fase == 2 and vuela.0 > 0.97 { emit landed }
    on landed {
        fase = 0
        wanted = false
        entra: 0 ~16ms
        vuela.0: 0 ~16ms after 40ms
        vuela.1: 0 ~16ms after 40ms
        vuela.2: 0 ~16ms after 40ms
        play gulp
    }

    // ── abrir y cerrar el oleaje ─────────────────────────────────
    //  Llegar no abre nada: se abre pulsándola a ella, o una gota.
    on abrir_bandeja { bandeja = true }
    on cerrar_bandeja { bandeja = false }
    follow tray = if(bandeja, 1, 0)
    //  Las gotas se van al carril en cuanto la bandeja empieza a salir.
    follow carril = if(bandeja, 1, 0)
    //  Y las filas llegan una tras otra, 35 ms entre cada una. Al cerrar se van
    //  al revés —de abajo arriba—, que es como se vacía algo de verdad.
    on change bandeja while bandeja {
        sube.1: 1 after 60ms
        sube.2: 1 after 95ms
        sube.3: 1 after 130ms
        sube.4: 1 after 165ms
        sube.5: 1 after 200ms
    }
    on change bandeja while not bandeja {
        sube.5: 0 ~120ms
        sube.4: 0 ~120ms after 35ms
        sube.3: 0 ~120ms after 70ms
        sube.2: 0 ~120ms after 105ms
        sube.1: 0 ~120ms after 140ms
    }
    //  Resolver una: se va a la derecha y suelta una gota de su color que
    //  vuelve volando a ella. Al llegar, el número de su gota baja con un toque
    //  y ella da un trago. Descartar no manda gota: lo descartado no vuelve.
    repeat k in 1..6 {
        //  Arrastrarla la sigue, y al soltar decide: pasado el umbral se va por
        //  donde iba, y si no vuelve sola con su muelle.
        on drag filazona.$k while viva.$k { tira.$k: drag.dx ~16ms }
        on release filazona.$k while viva.$k and tira.$k > 92 {
            tira.$k: 0 ~16ms
            fuera.$k: 1 ~220ms
            suelta.$k: 1 ~380ms
            deshacer = true
            ultima = k
            play arde
            emit resolver(k)
        }
        //  Descartar: se va por la izquierda y **no manda gota**.
        on release filazona.$k while viva.$k and tira.$k < -92 {
            tira.$k: 0 ~16ms
            fuera.$k: -1 ~220ms
            viva.$k = false
            emit descartar(k)
        }
        //  Y si no llegó al umbral, vuelve sola. Un toque —soltar donde se
        //  pulsó— es abrirlo, no marcarlo: `press` no vale para esto, porque
        //  arrastrar empieza por pulsar y lo daría por hecho al primer píxel.
        on release filazona.$k while viva.$k and tira.$k > -92 and tira.$k < 92 {
            tira.$k: 0
        }
        on release filazona.$k while viva.$k and tira.$k > -4 and tira.$k < 4 {
            emit abrir_aviso(k)
        }
        //  Cuando la gota llega a ella: la fila se apaga y ella da un trago.
        on still suelta.$k for 60ms while suelta.$k > 0.97 {
            viva.$k = false
            suelta.$k: 0 ~16ms
            fuera.$k: 0 ~16ms
            play gulp
        }
        //  Y la cuenta de SU categoría baja con un toque. Una regla por pareja
        //  de fila y categoría: las escribe el `repeat`, no yo.
        repeat c in 1..5 {
            on still suelta.$k for 60ms while suelta.$k > 0.97 and catfila.$k == c and n.$c > 0 {
                n.$c = n.$c - 1
                impulse late.$c 4
            }
            //  Y deshacer la devuelve: la fila vuelve a su sitio subiendo, y la
            //  cuenta de su gota sube otra vez con su latido.
            on press deshacer_zona while ultima == k and catfila.$k == c {
                viva.$k = true
                n.$c = n.$c + 1
                impulse late.$c 5
                deshacer = false
            }
        }
    }

    // ── la cuenta atrás ──────────────────────────────────────────
    //  Ocurre DENTRO de la bolita y ANTES de arrancar el grabador, así que no
    //  sale en el vídeo. Y el número nunca llega a enseñar el cero: el cero no
    //  es una cuenta, es el momento de empezar.
    //  Al salir vuelve a cero, y así entrar SIEMPRE es un cambio de 0 a 3: el
    //  tres se lleva su rebote como el dos y el uno, sin una regla aparte que
    //  luego se dispare dos veces.
    on change face while face != count { left = 0 }
    on change face while face == count { left = 3 }
    every 1s while face == count { left = left - 1 }
    //  El rebote DECRECE con la cuenta: tres golpes cada vez más pequeños para
    //  que el último aterrice en silencio justo cuando arranca el grabador. Un
    //  empujón a la velocidad del muelle, no una animación hasta un tamaño: por
    //  eso cada golpe sale de donde estaba el anterior en vez de cortarlo, y
    //  por eso la cantidad puede depender de la cuenta —que es lo que pleamar
    //  no sabía hacer: `impulse` solo aceptaba un número escrito—.
    on change left while left > 0 { impulse pop left * 2.5 }
    //  Solo si de verdad estaba contando: al salir de la cuenta `left` vuelve
    //  a cero, y sin esto parar a mitad de cuenta la mandaba a grabar.
    on change left while left == 0 and face == count { face = rec }

    // ── grabar: la esquina ───────────────────────────────────────
    //  Ella viaja por los bordes: sale por arriba con el mismo gesto de la
    //  foto y entra por la esquina, en otra superficie. Marea esconde una
    //  ventana y enseña otra; aquí se va de verdad y llega de verdad, y en
    //  medio no hay ningún frame donde esté en los dos sitios o en ninguno
    //  mientras se la mira.
    event record
    event stop
    fact corner = false
    //  Cuál de las cuatro. El contrato dice que se elige la que caiga FUERA de
    //  lo grabado; quien sabe qué se está grabando es la lógica, así que aquí
    //  solo se obedece. Grabando la pantalla entera no queda ninguna y saldrá
    //  en el vídeo, que es el trato de este modo.
    fact rincon: top_right | top_left | bottom_right | bottom_left = top_right
    //  0 fuera de la pantalla, 1 metida en la esquina. Vivo: entra con un
    //  rebote pequeño contra el ángulo, que es lo que la hace «encajarse».
    prop tuck = 0 ~lively
    follow tuck = if(corner, 1, 0)

    on record { para = rincon; play retire }
    //  «Ya cuenta desde la esquina que va a ocupar».
    on gone while para == rincon {
        away: 1 ~16ms
        corner = true
        face = count
    }
    //  El grabador lo arranca la lógica, y es ella quien dice `taping`. Aquí
    //  no hay grabador, así que hace de él una espera: 300 ms con la cara de
    //  grabar puesta. Lo importante es que son DOS hechos: el disco llega con
    //  la cara, y el rojo con el grabador.
    on still face for 300ms while face == rec { taping = true }
    on stop {
        taping = false
        corner = false
        face = eye
        away: 0 ~lively after 300ms
    }

    // ── lo que responde al ratón ─────────────────────────────────
    //  Debajo de ella: la pulsación es de la zona de más arriba.
    //  En Remanso la hora no sale —sale la cápsula—, así que su zona de gracia
    //  tampoco: declarada después, se quedaba con el clic de «Terminar», que le
    //  cae justo encima. La cápsula ya tiene la suya.
    zone box nota_conj { from: cx - 30, cy_real - 40; size: 200, 80; active: note and not remanso }
    zone box cuerpo_zona { at: cx, cy_real; size: 2 * r, 2 * r + 30; corner: r; cursor: pointer }
    //  Cualquier cosa que la necesite la saca; y vuelve a hundirse tras 2,6 s de
    //  gracia, que es lo que el contrato llama gracia y aquí se dice tal cual.
    on enter cuerpo_zona { needed = true; wanted = true }
    //  180 ms de espera antes de salir: pasar por encima no es preguntar la
    //  hora. Y 300 de gracia al irse, porque el hueco entre ella y la nota es
    //  real y no puede perderse al cruzarlo. Se va si se abre el panel.
    zone box nota_zona { at: nota.x, cy_real; size: 104, 56; corner: 13; cursor: pointer; active: nota > 0.8 }
    on hover cuerpo_zona for 180ms while not open { note = true }
    //  Y esto no manda en Remanso: con la zona apagada, «estar fuera» es verdad
    //  siempre, así que apagaba la cápsula 300 ms después de abrirla.
    on away nota_conj for 300ms while abanico < 0.01 and not remanso { note = false }
    //  Con el abanico fuera, la gracia se cuenta sobre el conjunto entero.
    on away abanico_conj for 300ms { note = false }
    on change open while open { note = false }
    on press nota_zona { emit calendar }
    //  Un solo reloj de gracia para todo lo que la necesita —el puntero, la
    //  nota, la tarjeta—: 2,6 s desde que lo ÚLTIMO deja de necesitarla. Con un
    //  `away` por zona, salir de ella hacia la nota ya contaba, y se hundía con
    //  la hora en la mano.
    fact wanted = false
    on leave cuerpo_zona while not note and not open { wanted = false }
    on change note while not note { wanted = false }
    on change open while not open { wanted = false }
    on still wanted for 2.6s while not wanted and not note and not open { needed = false }
    //  El clic abre; el roce no. Antes bastaban 450 ms de roce para que un panel
    //  entero tapara lo que estabas leyendo.
    on press cuerpo_zona { press: 1; toggle open }
    on release cuerpo_zona { press: 0 }
    // ── la esquina ───────────────────────────────────────────────
    //  Asoma el 82 %: con algo más de la mitad el ojo rojo se pasaba el rato
    //  detrás del borde, que es justo lo único para lo que sirve este modo.
    //  46 × 0,82 − 23 = 14,7: a eso del ángulo queda su centro.
    surface rincon {
        //  Ancha para el panel que le sale al acercarse, con su sombra.
        size: 260, 120
        //  El borde lo decide un hecho, y se cambia en marcha: layer-shell deja
        //  mover una superficie viva de esquina sin volver a crearla. Antes esto
        //  pedía cuatro superficies —era la limitación S13 de pleamar—.
        anchor: rincon
        level: overlay
        screens: "HDMI-A-1"
        //  Abierta mientras quede algo de ella dentro: así sale deslizándose
        //  en vez de desaparecer con la ventana.
        open: tuck > 0.01

        //  Dónde cae dentro de su superficie, según a qué ángulo esté pegada.
        //  Sale por el mismo ángulo por el que entró: lo que la esconde es el
        //  rincón, no una dirección fija.
        let ala.d = if(rincon == top_right or rincon == bottom_right, 1, 0)
        let ala.b = if(rincon == bottom_right or rincon == bottom_left, 1, 0)
        let rx = 14.7 + ala.d * (260 - 29.4) + (1 - tuck) * 44 * (ala.d * 2 - 1)
        let ry = 14.7 + ala.b * (120 - 29.4) + (1 - tuck) * 44 * (ala.b * 2 - 1)

        //  La mirada, plegada sobre su lado visible: mirar hacia su propia
        //  mitad escondida es mirar a ninguna parte. Pegada a la derecha solo
        //  mira hacia dentro, y arriba solo hacia abajo.
        prop rgaze.x = 0 ~gentle
        prop rgaze.y = 0 ~gentle
        look rgaze.x, rgaze.y at rx, ry reach 6, 3.5 within 260
        let mira.x = if(ala.d, min(rgaze.x, 0), max(rgaze.x, 0))
        let mira.y = if(ala.b, min(rgaze.y, 0), max(rgaze.y, 0))

        //  El reloj y «Detener», que salen DE ella al acercarse. No es un panel
        //  que aparece al lado: es el mismo cuerpo, que se estira hacia dentro de
        //  la pantalla como una gota y se separa —con su cuello a mitad de
        //  camino— hasta quedar a 8 px. Marea lo funde en 150 ms; aquí nace.
        fact cerca = false
        prop near = 0 ~lively
        follow near = if(cerca and tuck > 0.9, 1, 0)
        let p.w = 124 * near
        //  Y el panel sale por el lado de dentro de la pantalla, no siempre
        //  hacia la izquierda.
        let p.x = rx + (23 + 8 + 62) * near * (1 - ala.d * 2)
        let p.y = ry
        //  Cuánto tiempo lleva. Lo cuenta el render: un segundo es un segundo
        //  aunque la lógica esté ocupada arrancando un grabador.
        fact secs = 0
        on change taping while taping { secs = 0 }
        every 1s while taping { secs = secs + 1 }

        //  La zona de gracia va DEBAJO de todo lo demás: la pulsación es de la
        //  zona de más arriba, y declarada al final se quedaba con el clic de
        //  «Detener» y con el de ella.
        zone box alrededor { at: (p.x + rx) / 2, ry; size: abs(rx - p.x) + 140, 100; active: cerca }

        body {
            color: coal
            rim: 6%
            shadow: 0, 7, 16, 34%
            box { at: p.x, p.y; size: p.w, 42 * clamp(near * 3, 0, 1); corner: 13 }
            ellipse ella { at: rx, ry; radius: 23; scale: sx + press * 0.04, sy - press * 0.05; blend: 16 * 4 * near * (1 - near) }
        }
        group {
            //  Entra tarde: hasta que el panel no se ha despegado de ella, el
            //  botón quedaría debajo de su cara.
            opacity: clamp(near * 5 - 4, 0, 1)
            move: (1 - near) * 14, 0
            text "{secs, time}" { at: p.x - 46, p.y; anchor: left center; size: 13; weight: 600; color: ink }
            prop caliente = 0 ~140ms
            box { at: p.x + 22, p.y; size: 64, 26; corner: 8; color: mix(#e0655a, #f0796a, caliente) }
            text "Detener" { at: p.x + 22, p.y; anchor: center; size: 12; weight: 600; color: #060000 }
            zone box parar { at: p.x + 22, p.y; size: 64, 26; corner: 8; cursor: pointer; active: near > 0.8 }
            on enter parar { caliente: 1 }
            on leave parar { caliente: 0 }
            on press parar { emit stop }
        }
        //  La cara va un poco hacia dentro, para que el disco quede a la vista.
        Cara(rx - 5 * (ala.d * 2 - 1), ry + 4 * (1 - ala.b * 2), mira.x, mira.y)

        //  Pulsarla para.
        zone box ella_zona { at: rx, ry; size: 46, 46; corner: 23; cursor: pointer }
        on press ella_zona { press: 1; emit stop }
        on release ella_zona { press: 0 }
        //  Acercarse lo saca; y se recoge con 320 ms de gracia, porque el hueco
        //  entre ella y el panel es real y no puede perderse al cruzarlo.
        on enter ella_zona { cerca = true }
        on away alrededor for 320ms { cerca = false }
        on stop { cerca = false }
    }
}
