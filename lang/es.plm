        "On · {remaining, 0} min" = "Puesto · {remaining, 0} min"
        "Her wardrobe" = "Su armario"
        "Shall we take a break?" = "¿Hacemos una pausa?"
        "Confirm" = "Confirmar"
        "Looking for networks…" = "Buscando redes…"
        "Nothing paired" = "Nada emparejado"
        "Each piece chases in its own way: the hat rests, the glasses stay stuck on and the mug keeps her company." = "Cada pieza persigue a su manera: el gorro se apoya, las gafas van pegadas y la taza acompaña."
        "Hat" = "Gorro"
        "Glasses" = "Gafas"
        "Mug" = "Taza"
        "rests" = "se apoya"
        "stuck on" = "pegadas"
        "tags along" = "acompaña"
        "OUTPUT" = "SALIDA"
        "INPUT" = "ENTRADA"
        "Nothing to choose" = "Nada que elegir"
        "Appearance" = "Aspecto"
        "HER LOOK" = "SU ASPECTO"
        "Made of glass like Apple's, or the usual one." = "De cristal como el de Apple, o la de siempre."
        "Liquid" = "Líquida"
        "Light liquid" = "Líquida ligera"
        "Classic" = "La de siempre"
        "Bends what's behind" = "Dobla lo de detrás"
        "Blurs it" = "Lo desenfoca"
        "Opaque, no glass" = "Opaca, sin cristal"
        "Liquid reads the screen behind her to bend it: it costs a little more." = "La líquida lee la pantalla detrás de ella para doblarla: gasta un poco más."
        "HER HOME" = "SU CASA"
        "You can leave her on one monitor, or have her follow you." = "Puedes dejarla en un monitor, o que te siga."
        "Follow me" = "Sígueme"
        "She goes to the monitor where you are working" = "Se va al monitor donde estés trabajando"
        "Her own strip" = "Su propia franja"
        "Windows leave her the top, instead of going under her" = "Las ventanas le dejan la parte de arriba en vez de ir por debajo"
        "THE LOCK" = "EL BLOQUEO"
        "Safety net: Esc opens it too, and it opens itself after a minute" = "Con red: Esc también lo abre, y se abre solo al minuto"
        "Remove it once you trust your password. It lasts until a restart" = "Quítala cuando te fíes de tu contraseña. Vale hasta que se reinicie"
        "You change the wallpaper from her menu: Customize." = "El fondo lo cambias desde su menú: Personalizar."
        "Asking it for its menu…" = "Preguntándole su menú…"
        "Lock" = "Bloquear"
        "Protect the session" = "Proteger la sesión"
        "Suspend" = "Suspender"
        "Go into standby" = "Poner en reposo"
        "When you're done" = "Al terminar"
        "Log out" = "Cerrar sesión"
        "Restart" = "Reiniciar"
        "Power off" = "Apagar"
        "Esc to go back" = "Esc para volver"
        "Log out?" = "¿Cerrar la sesión?"
        "Restart the computer?" = "¿Reiniciar el equipo?"
        "Shut down the computer?" = "¿Apagar el equipo?"
        "Applications will be closed." = "Se cerrarán las aplicaciones."
        "Save your changes before continuing." = "Guarda tus cambios antes de continuar."
        "Back" = "Volver"
        "Shut down" = "Apagar equipo"
        "While it lasts, notices are kept and not shown." = "Mientras dure, los avisos se guardan y no se enseñan."
        "Nothing playing" = "No suena nada"
        "Password" = "Contraseña"
        "Checking…" = "Comprobando…"
        "Enter to unlock" = "Intro para entrar"
        "Esc to exit · test lock" = "Esc para salir · bloqueo de prueba"
        "Stop" = "Detener"

        // the same in both languages: said anyway, so loading says nothing is missing
        "1 h" = "1 h"
        "2 min" = "2 min"
        "3 h" = "3 h"
        "25 min" = "25 min"
        "{25 + m * 20} min" = "{25 + m * 20} min"
        "Ana Ruiz" = "Ana Ruiz"
        "TELEGRAM" = "TELEGRAM"
        "MAREA" = "MAREA"
        "Wi-Fi" = "Wi-Fi"
        "Bluetooth" = "Bluetooth"
        "General" = "General"
        "Esc" = "Esc"
        "z" = "z"
        "LANGUAGE" = "IDIOMA"
        "English" = "English"
        "Español" = "Español"
        "Recording saved" = "Grabación guardada"
        "Watch" = "Ver"
        "Copy path" = "Copiar ruta"
