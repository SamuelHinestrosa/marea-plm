        "Join" = "Unirse"
        "Clear" = "Vaciar"
        "Carry anything over her: a link, a file, an image." = "Arrástrale lo que quieras: un enlace, un fichero, una imagen."
        "Deriva" = "Deriva"
        "Search what she keeps" = "Busca en lo que guarda"
        "{drift.kept, 0} kept" = "{drift.kept, 0} guardadas"
        "Drop it in Deriva" = "Suéltalo en Deriva"
        "Read later" = "Leer luego"
        "Inspiration" = "Inspiración"
        "Nothing has washed up yet" = "La marea aún no ha traído nada"
        "Looking around…" = "Buscando alrededor…"
        "Pair" = "Emparejar"
