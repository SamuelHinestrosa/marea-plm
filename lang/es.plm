// The Spanish of what the scene itself writes: each English text as it appears
// in marea.plm, and what it becomes in Spanish. The logic's own strings live in
// es-logic.plm; the demo batch's rows the scene starts with are here, and the logic
// uses these same English words for them.
library SpanishUi {
    translations es {
        "CALENDAR" = "CALENDARIO"
        "Agents" = "Agentes"
        "Today" = "Hoy"
        "Siempre en español" = "Siempre en español"
        "ES" = "ES"
        "EN" = "EN"
        "Aa" = "Aa"
        "Language" = "Idioma"
        "Safety net" = "Red de seguridad"
        "While you try it out, a safety net: Esc also opens it, and it opens by itself after a minute." = "Mientras lo pruebas, una red de seguridad: Esc también la abre, y se abre sola al cabo de un minuto."
        "Her lock screen opens with your password." = "Su pantalla de bloqueo se abre con tu contraseña."
        "Always in English" = "Siempre en inglés"
        "The one your session speaks" = "El que habla tu sesión"
        "The language she speaks in." = "El idioma en el que habla."
        "Her home" = "Su casa"
        "Choose her monitor, or let her follow you." = "Elige su monitor, o deja que te siga."
        "Hats, glasses and the background" = "Sombreros, gafas y el fondo"
        "Password only" = "Solo contraseña"
        "Safety net on" = "Red de seguridad activa"
        "Follows you" = "Te sigue"
        "Wardrobe and wallpaper" = "Armario y fondo"
        "The lock" = "El bloqueo"
        "Her look" = "Su aspecto"
        "Where she lives" = "Dónde vive"
        "Nothing yet." = "Nada todavía."
        "New event: 10:30 Dentist" = "Nuevo evento: 10:30 Dentista"
        "Start with a time, or leave it for the whole day. Enter saves it." = "Empieza con una hora, o déjalo para todo el día. Intro lo guarda."
        "Reading your windows…" = "Leyendo tus ventanas…"
        "left" = "quedan"
        "MAIL" = "CORREO"
        "SYSTEM" = "SISTEMA"
        "Design review" = "Revisión de diseño"
        "September invoice" = "Factura de septiembre"
        "Building site group" = "Grupo de la obra"
        "Lunch today? I have a table at two" = "¿Comemos hoy? Tengo mesa a las dos"
        "in 10 minutes · big room" = "en 10 minutos · sala grande"
        "due on the 30th" = "vence el 30"
        "6 unread messages" = "6 mensajes sin leer"
        "now" = "ahora"
        "Backup done" = "Copia de seguridad hecha"
        "412 files, 2.1 GB" = "412 ficheros, 2,1 GB"
        "yesterday" = "ayer"
        "Do not disturb · {remaining, 0} min" = "No molestar · {remaining, 0} min"
        "{pending, 0} notices kept" = "{pending, 0} avisos guardados"
        "End" = "Terminar"
        "View rules" = "Ver reglas"
        "{pending, 0} important updates" = "{pending, 0} novedades importantes"
        "+{burst - 3, 0} more" = "+{burst - 3, 0} más"
        "SWELL" = "OLEAJE"
        "Now" = "Ahora"
        "Messages" = "Mensajes"
        "Work" = "Trabajo"
        "Calendar" = "Calendario"
        "System" = "Sistema"
        "View all" = "Ver todo"
        "Done" = "Hecho"
        "Open" = "Abrir"
