// What marea.luau writes itself, in Spanish. The logic writes it in English
// through `tr("…")`; this is the table `tr` reads when `locale` is `es`.
//
// Both libraries fill the same table, and a text translated twice is an error:
// what the scene also writes —the demo batch's rows it starts with, «now»,
// «History»— is already in es.plm, and the logic uses those same English words.
library SpanishLogic {
    translations es {
        // the finder
        // what is hers, in the finder («Agents», «Settings»… are in es.plm)
        "Lock the screen" = "Bloquear la pantalla"
        "Screenshot of a region" = "Captura de una zona"
        "Screenshot of the screen" = "Captura de la pantalla"
        "Screenshot of a window" = "Captura de una ventana"
        "Record the screen" = "Grabar la pantalla"
        "Celebrate" = "Celebrar"
        "Rage" = "Enfado"
        "Adventure" = "Aventura"
        // pleamar-wm's window manager, from her menu and her finder
        "Windows" = "Ventanas"
        "Tiled or free windows" = "Ventanas en mosaico o libres"
        "Bring back every window" = "Recuperar todas las ventanas"
        "Rain on the windows" = "Lluvia en las ventanas"

        // the calendar
        "January" = "enero"
        "February" = "febrero"
        "March" = "marzo"
        "April" = "abril"
        "May" = "mayo"
        "June" = "junio"
        "July" = "julio"
        "August" = "agosto"
        "September" = "septiembre"
        "October" = "octubre"
        "November" = "noviembre"
        "December" = "diciembre"
        "Monday" = "Lunes"
        "Tuesday" = "Martes"
        "Wednesday" = "Miércoles"
        "Thursday" = "Jueves"
        "Friday" = "Viernes"
        "Saturday" = "Sábado"
        "Sunday" = "Domingo"
        "Mo" = "L"
        "Tu" = "M"
        "We" = "X"
        "Th" = "J"
        "Fr" = "V"
        "Sa" = "S"
        "Su" = "D"
        "Free day" = "Día libre"
        "1 event" = "1 evento"
        "%d events" = "%d eventos"
        "all day" = "todo el día"
        "%s %d" = "%s de %d"

        // the agents' reservoirs
        "5 hours" = "5 horas"
        "Weekly" = "Semanal"
        "server" = "servidor"
        "on this machine" = "en este equipo"
        "just now" = "ahora mismo"
        "%s ago" = "hace %s"
        "renewed?" = "¿renovada?"
        "not started" = "sin empezar"
        "in %s" = "en %s"

        "Application" = "Aplicación"
        "Folder" = "Carpeta"
        "File" = "Archivo"

        // her menu: the plugins that bring something, and what they bring
        // («History» is in es.plm)
        "Drift" = "Deriva"
        "Swell" = "Oleaje"
        "Lend something" = "Prestar algo"
        "Release what was lent" = "Soltar lo prestado"

        // the system tray: going back up a submenu
        "‹  Back" = "‹  Volver"

        // the swell: a real notice whose application has no name
        "notice" = "aviso"

        // the swell in demo mode: what of the invented batch is not in es.plm
        "I'll call you in five" = "te llamo en cinco"
        "Battery at 8 %" = "Batería al 8 %"
        "about 12 minutes left" = "quedan unos 12 minutos"
    }
}
