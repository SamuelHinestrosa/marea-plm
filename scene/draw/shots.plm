// Marea's scene, in pieces: the shots. marea.plm includes it.
part Shots {
    // ── the shots ────────────────────────────────────────────────
    //  Where each one lands, on her surface: around her and below, never on her.
    event bang.1
    event bang.2
    event bang.3
    event bang.4
    event bang.5
    let tgt.x.1 = 170
    let tgt.y.1 = 250
    let tgt.x.2 = 560
    let tgt.y.2 = 330
    let tgt.x.3 = 300
    let tgt.y.3 = 470
    let tgt.x.4 = 660
    let tgt.y.4 = 190
    let tgt.x.5 = 110
    let tgt.y.5 = 440
    //  She aims at the next one: as soon as a shot is fired, at the one after.
    let aim.next = min(5, 1 + round(shot.1 + shot.2 + shot.3 + shot.4 + shot.5))
    prop aim.x = 170 ~quick
    prop aim.y = 250 ~quick
    follow aim.x = if(aim.next < 1.5, tgt.x.1, if(aim.next < 2.5, tgt.x.2, if(aim.next < 3.5, tgt.x.3, if(aim.next < 4.5, tgt.x.4, tgt.x.5))))
    follow aim.y = if(aim.next < 1.5, tgt.y.1, if(aim.next < 2.5, tgt.y.2, if(aim.next < 3.5, tgt.y.3, if(aim.next < 4.5, tgt.y.4, tgt.y.5))))
    //  The pistol, on the side she aims to: it swaps hands, and flips so the
    //  grip stays down.
    let side = if(aim.x < cx, -1, 1)
    //  Blowing, the pistol comes up beside her mouth, barrel to the sky.
    let gun.x = cx + (40 - 12 * blow) * side
    let gun.y = cy_actual + 14 + 8 * blow
    let gun.aim = atan2(aim.y - gun.y, aim.x - gun.x)
    //  Up is −90° from the right hand and 270° from the left: the nearer way round.
    let gun.angle = gun.aim + (if(side > 0, -90, 270) - gun.aim) * blow
    let muzzle.x = gun.x + cos(gun.angle) * 36
    let muzzle.y = gun.y + sin(gun.angle) * 36

    //  The broken glass: a shader of her own at each hole, bending what is
    //  behind the screen. And the shards that jump out of it.
    shader cracks = file "../../shaders/cracks.wgsl"
    repeat k in 1..6 {
        on change shot.$k > 0.5 while shot.$k > 0.5 and raging { emit bang.$k }
        on bang.$k { crack.$k: 1 ~300ms; flash: 1 ~16ms; flash: 0 ~120ms after 50ms; play recoil }
        shader cracks { at: tgt.x.$k - 140, tgt.y.$k - 140; size: 280, 280; values: crack.$k, k * 1.37, fade
                        show: crack.$k > 0.01 and fade > 0.01 }
        particles { at: tgt.x.$k, tgt.y.$k; count: 45; life: 0.5s .. 1.1s; speed: 60 .. 280; spread: 360deg
                    gravity: 0, 700; drag: 0.6; size: 3.2, 1; colors: #ffffff, #bfe3ff; opacity: 95%, 0%
                    shape: square; burst: bang.$k }
        particles { at: tgt.x.$k, tgt.y.$k; count: 25; life: 0.4s .. 0.9s; speed: 20 .. 90; spread: 360deg
                    drag: 2; size: 5, 9; colors: #8a8f96, #5a5e63; opacity: 35%, 0%; burst: bang.$k }
        //  The tracer: from the muzzle to the hole, too fast to see as anything
        //  but a streak.
        particles { at: muzzle.x, muzzle.y; count: 2; life: length(tgt.x.$k - muzzle.x, tgt.y.$k - muzzle.y) / 3200
                    speed: 3200; direction: atan2(tgt.y.$k - muzzle.y, tgt.x.$k - muzzle.x) * 1deg; spread: 0
                    size: 3, 3; colors: #fff6d8; opacity: 100%, 100%; shape: spark; burst: bang.$k }
        //  And the flash's sparks, out of the muzzle.
        group {
            glow: 8, 120%
            mode: add
            particles { at: muzzle.x, muzzle.y; count: 20; life: 0.08s .. 0.22s; speed: 90 .. 260
                        direction: gun.angle * 1deg; spread: 60deg; size: 3, 0; colors: #fff1b8, #ff8a3d; shape: spark; burst: bang.$k }
        }
    }

    //  The pistol itself: slide, barrel, frame, grip and trigger guard, drawn
    //  pointing right from its pivot and turned to where she aims. It slides
    //  out of her, and kicks back and up with every shot.
    group {
        opacity: gun
        pivot: gun.x, gun.y
        rotate: gun.angle * 1deg - kick * 0.35 * side - (1 - gun.twirl) * 4 * 3.14159265 * side
        scale: 0.4 + 0.6 * gun, (0.4 + 0.6 * gun) * side
        move: (1 - gun) * -26 * side, 0
        box { at: gun.x + 17 - 6 * kick, gun.y - 4; size: 30, 9; corner: 2; color: #2b2e33 }
        box { at: gun.x + 33 - 6 * kick, gun.y - 4; size: 3, 6; corner: 1; color: #121416 }
        box { at: gun.x + 13 - 6 * kick, gun.y + 1.5; size: 22, 5; corner: 1.5; color: #22252a }
        box { at: gun.x + 5 - 6 * kick, gun.y + 10; size: 9, 17; corner: 2.5; rotate: 0.28; color: #1b1d20 }
        ellipse { at: gun.x + 14 - 6 * kick, gun.y + 7; radius: 3.6; stroke: 1.6; color: #1b1d20 }
        line { from: gun.x + 4 - 6 * kick, gun.y - 8; to: gun.x + 31 - 6 * kick, gun.y - 8; width: 1; color: ink; opacity: 25% }
        box { at: gun.x + 22 - 6 * kick, gun.y - 4; size: 6, 2; corner: 1; color: ink; opacity: 12% }
    }
    //  The smoke she blows off: grey puffs that grow, rise and thin out.
    particles { at: muzzle.x, muzzle.y; count: 60; life: 0.9s .. 1.6s; speed: 12 .. 34; direction: -90deg; spread: 50deg
                drag: 0.8; size: 4, 15; colors: #b8bcc2, #7d8288; opacity: 45%, 0%; emit: blow > 0.8 and raging }
    //  The muzzle flash: a bright star that lasts a blink.
    group {
        glow: 12, 140%
        mode: add
        ellipse { at: muzzle.x, muzzle.y; radius: 9 * flash; color: #fff1b8; opacity: flash }
        ellipse { at: muzzle.x + cos(gun.angle) * 8, muzzle.y + sin(gun.angle) * 8; radius: 5 * flash; color: #ff9f43; opacity: flash }
    }

}
